/*
 * Surf Pool Sim UI: premium beach-resort look.
 * Palette: cream cards #FFF7EC, sand borders #EBD9BF, deep-sea navy text #0B2E3A, ocean teal #14B8A6,
 * sunset coral #FF6B57 (bad news, send), sun yellow #FFC857 (prices), money green #0E9F7E.
 * Font: Fredoka (OFL, Assets/_Game/UI/Fonts).
 */

.hidden {
    display: none;
}

.layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.hud-root,
.screen-overlay {
    -unity-font-definition: url("project://database/Assets/_Game/UI/Fonts/Fredoka.ttf");
}

/* ---------- HUD ---------- */

.hud-root {
    flex-grow: 1;
}

.card {
    background-color: rgba(255, 247, 236, 0.94);
    border-radius: 18px;
    border-width: 2px;
    border-color: #EBD9BF;
    padding: 12px 20px;
}

.top-left {
    position: absolute;
    left: 32px;
    top: 28px;
}

.top-right {
    position: absolute;
    right: 32px;
    top: 28px;
    width: 370px;
}

.money-label {
    font-size: 52px;
    -unity-font-style: bold;
    color: #0E9F7E;
}

.money-label--negative {
    color: #FF6B57;
}

.rating-row {
    flex-direction: row;
    align-items: center;
    margin-top: 2px;
}

.star-rating {
    width: 150px;
    height: 28px;
}

.rating-label {
    font-size: 21px;
    -unity-font-style: bold;
    color: #0B2E3A;
    margin-left: 10px;
}

.popup-stack {
    height: 40px;
    margin-top: 8px;
}

.popup {
    position: absolute;
    left: 6px;
    top: 0;
    font-size: 28px;
    -unity-font-style: bold;
    color: #FFFFFF;
    background-color: #0E9F7E;
    border-radius: 10px;
    padding: 2px 12px;
    transition-duration: 1.3s;
    transition-timing-function: ease-out;
}

.popup--negative {
    background-color: #FF6B57;
}

.popup--leaving {
    opacity: 0;
    translate: 0 -48px;
}

.section-title {
    font-size: 15px;
    -unity-font-style: bold;
    color: #C9824F;
    letter-spacing: 2px;
    margin-bottom: 6px;
}

.wave-type {
    font-size: 26px;
    -unity-font-style: bold;
    color: white;
    padding: 4px 14px;
    border-radius: 10px;
    align-self: flex-start;
}

.wave-type--beginner {
    background-color: #38B6D9;
}

.wave-type--intermediate {
    background-color: #3D6BE0;
}

.wave-type--pro {
    background-color: #B5179E;
}

.bar {
    height: 10px;
    background-color: rgba(11, 46, 58, 0.12);
    border-radius: 5px;
    margin-top: 10px;
    overflow: hidden;
}

.bar-fill {
    height: 100%;
    background-color: #14B8A6;
}

.bar-fill--charging {
    background-color: #FFC857;
}

.small-text {
    font-size: 16px;
    color: #5B6B73;
    margin-top: 4px;
}

.divider {
    height: 2px;
    background-color: #EBD9BF;
    margin: 12px 0;
}

.stat-row {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 4px;
}

.stat-name {
    font-size: 18px;
    color: #5B6B73;
}

.stat-value {
    font-size: 18px;
    -unity-font-style: bold;
    color: #0B2E3A;
}

.stat-value--bad {
    color: #FF6B57;
}

.crosshair {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 8px;
    height: 8px;
    margin-left: -4px;
    margin-top: -4px;
    border-radius: 4px;
    background-color: rgba(255, 255, 255, 0.95);
    transition-duration: 0.12s;
}

.crosshair--active {
    width: 20px;
    height: 20px;
    margin-left: -10px;
    margin-top: -10px;
    border-radius: 10px;
    border-width: 3px;
    border-color: #FFC857;
    background-color: rgba(255, 200, 87, 0.25);
}

.prompt {
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    margin-top: 36px;
    flex-direction: row;
    justify-content: center;
}

.prompt-box {
    flex-direction: row;
    align-items: center;
    background-color: rgba(255, 247, 236, 0.95);
    border-radius: 14px;
    border-width: 2px;
    border-color: #EBD9BF;
    padding: 8px 20px 8px 8px;
}

.key-badge {
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background-color: #14B8A6;
    color: white;
    font-size: 22px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-right: 12px;
}

.prompt-label {
    font-size: 24px;
    -unity-font-style: bold;
    color: #0B2E3A;
}

.click-to-play {
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    margin-top: 36px;
    font-size: 32px;
    -unity-font-style: bold;
    color: white;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(11, 46, 58, 0.6);
}

.hint {
    position: absolute;
    left: 32px;
    bottom: 24px;
    font-size: 17px;
    color: white;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(11, 46, 58, 0.5);
    transition-duration: 1.5s;
}

.hint--hidden {
    opacity: 0;
}

.toasts {
    position: absolute;
    left: 0;
    right: 0;
    top: 28px;
    align-items: center;
}

.toast {
    background-color: rgba(255, 247, 236, 0.96);
    border-radius: 12px;
    border-width: 2px;
    border-left-width: 8px;
    border-color: #EBD9BF;
    border-left-color: #14B8A6;
    padding: 8px 20px;
    margin-bottom: 8px;
    font-size: 20px;
    color: #0B2E3A;
    transition-duration: 0.5s;
}

.toast--bad {
    border-left-color: #FF6B57;
}

.toast--leaving {
    opacity: 0;
}

/* ---------- Surfer speech bubbles ---------- */

.bubble {
    position: absolute;
    align-items: center;
    translate: -50% -100%;
    -unity-font-definition: url("project://database/Assets/_Game/UI/Fonts/Fredoka.ttf");
}

.bubble-box {
    flex-direction: row;
    align-items: center;
    background-color: rgba(255, 255, 255, 0.96);
    border-radius: 16px;
    padding: 4px 12px 4px 4px;
}

.bubble-tail {
    width: 12px;
    height: 12px;
    background-color: rgba(255, 255, 255, 0.96);
    rotate: 45deg;
    margin-top: -7px;
}

.skill-badge {
    width: 28px;
    height: 28px;
    border-radius: 14px;
    color: white;
    font-size: 15px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.skill-badge--beginner {
    background-color: #38B6D9;
}

.skill-badge--intermediate {
    background-color: #3D6BE0;
}

.skill-badge--pro {
    background-color: #B5179E;
}

.bubble-text {
    font-size: 17px;
    -unity-font-style: bold;
    color: #0B2E3A;
    margin-left: 6px;
}

.patience {
    width: 74px;
    height: 8px;
    background-color: rgba(11, 46, 58, 0.55);
    border-radius: 4px;
    margin-top: 5px;
    overflow: hidden;
}

.patience-fill {
    height: 100%;
    background-color: #2BD9A0;
}

.patience-fill--mid {
    background-color: #FFC857;
}

.patience-fill--low {
    background-color: #FF6B57;
}

/* ---------- Full-screen panels (SurfOS upgrades, Wave Control) ---------- */

.screen-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(11, 46, 58, 0.45);
    align-items: center;
    justify-content: center;
}

.screen-window {
    width: 1100px;
    height: 780px;
    background-color: #FFF7EC;
    border-radius: 24px;
    border-width: 3px;
    border-color: #EBD9BF;
    border-top-width: 10px;
    border-top-color: #14B8A6;
    padding: 22px 30px 26px 30px;
}

.screen-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.screen-title {
    font-size: 38px;
    -unity-font-style: bold;
    color: #0B2E3A;
}

.screen-subtitle {
    font-size: 16px;
    color: #6B7B83;
}

.screen-money {
    font-size: 38px;
    -unity-font-style: bold;
    color: #0E9F7E;
}

.tabs {
    flex-direction: row;
    margin: 18px 0 14px 0;
}

.tab {
    font-size: 20px;
    -unity-font-style: bold;
    color: #0B2E3A;
    background-color: rgba(11, 46, 58, 0.06);
    border-width: 0;
    border-radius: 12px;
    padding: 10px 26px;
    margin: 0 10px 0 0;
    transition-duration: 0.12s;
}

.tab:hover {
    background-color: rgba(11, 46, 58, 0.12);
}

.tab--active,
.tab--active:hover {
    background-color: #14B8A6;
    color: white;
}

.cards {
    flex-grow: 1;
}

.card-row {
    flex-direction: row;
}

.upgrade-card {
    width: 490px;
    margin: 0 12px 12px 0;
    background-color: white;
    border-radius: 16px;
    border-width: 2px;
    border-left-width: 8px;
    border-color: #EBD9BF;
    border-left-color: #14B8A6;
    padding: 14px 16px;
}

.upgrade-card--waves {
    border-left-color: #3D6BE0;
}

.upgrade-card--park {
    border-left-color: #FFC857;
}

.upgrade-card--rentals {
    border-left-color: #FF8A5B;
}

.upgrade-card--staff {
    border-left-color: #2BD9A0;
}

.card-top {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.card-title {
    font-size: 22px;
    -unity-font-style: bold;
    color: #0B2E3A;
    flex-shrink: 1;
}

.cost-chip {
    font-size: 18px;
    -unity-font-style: bold;
    color: #0B2E3A;
    background-color: #FFC857;
    border-radius: 10px;
    padding: 3px 12px;
}

.card-desc {
    font-size: 16px;
    color: #5B6B73;
    white-space: normal;
    margin-top: 6px;
    flex-grow: 1;
}

.card-requires {
    font-size: 15px;
    color: #E2603F;
    margin-top: 4px;
}

.buy-button {
    margin: 10px 0 0 0;
    height: 44px;
    font-size: 19px;
    -unity-font-style: bold;
    border-width: 0;
    border-radius: 12px;
    background-color: #14B8A6;
    color: white;
    transition-duration: 0.12s;
}

.buy-button:hover {
    background-color: #0EA394;
}

.buy-button--owned,
.buy-button--owned:hover {
    background-color: rgba(14, 159, 126, 0.12);
    color: #0E9F7E;
}

.buy-button--blocked,
.buy-button--blocked:hover {
    background-color: rgba(11, 46, 58, 0.06);
    color: rgba(11, 46, 58, 0.4);
}

.screen-footer {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-top: 12px;
}

.screen-message {
    font-size: 18px;
    color: #C9824F;
}

.close-button {
    width: 180px;
    height: 46px;
    font-size: 18px;
    -unity-font-style: bold;
    border-width: 2px;
    border-color: #EBD9BF;
    border-radius: 12px;
    background-color: white;
    color: #0B2E3A;
}

.close-button:hover {
    background-color: #FFF1DE;
}

/* ---------- Wave Control panel ---------- */

.wave-window {
    width: 1000px;
    height: auto;
}

.section-gap {
    margin-top: 18px;
}

.wave-cards {
    flex-direction: row;
}

.wave-card {
    flex-grow: 1;
    flex-basis: 0;
    margin-right: 14px;
    background-color: white;
    border-radius: 16px;
    border-width: 3px;
    border-color: #EBD9BF;
    padding: 16px;
    transition-duration: 0.12s;
}

.wave-card--last {
    margin-right: 0;
}

.wave-card:hover {
    border-color: #CFE9E5;
}

.wave-card--selected,
.wave-card--selected:hover {
    border-color: #FFC857;
    background-color: #FFFBF2;
}

.wave-card--locked {
    opacity: 0.5;
}

.wave-card-text {
    font-size: 16px;
    color: #5B6B73;
    margin-top: 10px;
    white-space: normal;
}

.wave-card-waiting {
    font-size: 18px;
    -unity-font-style: bold;
    color: #0E9F7E;
    margin-top: 10px;
}

.wave-card-locked {
    font-size: 15px;
    color: #E2603F;
    margin-top: 10px;
    white-space: normal;
}

.segment-row {
    flex-direction: row;
}

.segment {
    flex-grow: 1;
    flex-basis: 0;
    height: 54px;
    font-size: 20px;
    -unity-font-style: bold;
    border-width: 0;
    border-radius: 12px;
    margin: 0 10px 0 0;
    background-color: rgba(11, 46, 58, 0.06);
    color: #0B2E3A;
    transition-duration: 0.12s;
}

.segment:hover {
    background-color: rgba(11, 46, 58, 0.12);
}

.segment--selected,
.segment--selected:hover {
    background-color: #14B8A6;
    color: white;
}

.send-button {
    flex-grow: 1;
    height: 66px;
    margin: 0 14px 0 0;
    font-size: 28px;
    -unity-font-style: bold;
    border-width: 0;
    border-radius: 16px;
    background-color: #FF6B57;
    color: white;
    transition-duration: 0.12s;
}

.send-button:hover {
    background-color: #F25541;
}

.send-button--charging,
.send-button--charging:hover {
    background-color: rgba(11, 46, 58, 0.08);
    color: rgba(11, 46, 58, 0.45);
}

/* ---------- Missions ---------- */

.mission-card {
    position: absolute;
    left: 32px;
    top: 200px;
    width: 380px;
}

.mission-title {
    font-size: 24px;
    -unity-font-style: bold;
    color: #0B2E3A;
}

.mission-story {
    font-size: 15px;
    color: #5B6B73;
    white-space: normal;
    margin-top: 4px;
}

.mission-objectives {
    margin-top: 8px;
}

.objective-row {
    flex-direction: row;
    align-items: center;
    margin-top: 4px;
}

.objective-check {
    width: 18px;
    height: 18px;
    border-radius: 5px;
    border-width: 2px;
    border-color: #14B8A6;
    margin-right: 8px;
}

.objective-check--done {
    background-color: #14B8A6;
}

.objective-text {
    font-size: 17px;
    color: #0B2E3A;
    white-space: normal;
    flex-shrink: 1;
}

.objective-text--done {
    color: #8FA3AB;
}

.mission-hint {
    font-size: 15px;
    color: #C9824F;
    white-space: normal;
    margin-top: 8px;
}

.mission-marker {
    position: absolute;
    align-items: center;
    translate: -50% -100%;
}

.marker-diamond {
    width: 22px;
    height: 22px;
    rotate: 45deg;
    background-color: #FFC857;
    border-width: 3px;
    border-color: #0B2E3A;
    border-radius: 4px;
}

.marker-distance {
    font-size: 16px;
    -unity-font-style: bold;
    color: white;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(11, 46, 58, 0.8);
    margin-top: 6px;
}

.mission-banner {
    position: absolute;
    left: 0;
    right: 0;
    top: 22%;
    -unity-text-align: middle-center;
    font-size: 44px;
    -unity-font-style: bold;
    color: white;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgba(11, 46, 58, 0.7);
    transition-duration: 0.6s;
}

.mission-banner--leaving {
    opacity: 0;
    translate: 0 -30px;
}

/* ---------- Story letter ---------- */

.story-window {
    width: 820px;
    height: auto;
}

.story-body {
    font-size: 20px;
    color: #0B2E3A;
    white-space: normal;
    margin-top: 16px;
}

.story-signature {
    font-size: 22px;
    -unity-font-style: bold;
    color: #C9824F;
    margin-top: 16px;
}

.story-button {
    margin: 22px 0 0 0;
    flex-grow: 0;
}

/* ---------- Day clock and end-of-day report ---------- */

.day-label {
    font-size: 16px;
    color: #5B6B73;
    margin-top: 4px;
}

.report-window {
    width: 880px;
    height: auto;
}

.report-columns {
    flex-direction: row;
}

.report-column {
    flex-grow: 1;
    flex-basis: 0;
    background-color: white;
    border-radius: 16px;
    border-width: 2px;
    border-color: #EBD9BF;
    padding: 14px 18px;
    margin-right: 14px;
}

.report-column--last {
    margin-right: 0;
}

.report-name {
    font-size: 18px;
    color: #5B6B73;
}

.report-value {
    font-size: 18px;
    -unity-font-style: bold;
    color: #0B2E3A;
}

.report-empty {
    font-size: 16px;
    color: #8FA3AB;
}

.report-totals {
    font-size: 22px;
    -unity-font-style: bold;
    color: #0E9F7E;
    margin-top: 18px;
}
