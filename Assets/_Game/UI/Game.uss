/*
 * Surf Pool Sim UI: "Sunset Surf Shop".
 * The UI is the surf shop's counter: cream paper cards, deep-sea ink outlines, chunky toy-like bottom edges,
 * a sunset palette, and painted-sign fonts. Rules of thumb:
 *   - Dark ink outline = you can click it. Passive cards get a sand edge instead.
 *   - Every card/window has an ink name strip on top (like a shop sign); the body is cream paper.
 *   - Yellow = money and rewards. Coral = bad news / "send". Teal = go / selected.
 *   - Lilita One = titles, numbers, buttons. Fredoka = reading text. Pacifico = little hand-painted taglines only.
 * Fonts are OFL (Assets/_Game/UI/Fonts, license files next to them). Art comes from tools/ui/make_ui_art.py,
 * icons from tools/ui/make_icons.py.
 */

:root {
    --ink: #0B2E3A;
    --ink-soft: #24505E;
    --teal: #14B8A6;
    --teal-dark: #0C8C7E;
    --lagoon: #7EE0D2;
    --coral: #FF6B57;
    --coral-dark: #D94A38;
    --orange: #FF9A3D;
    --sun: #FFC857;
    --sun-dark: #E0A22E;
    --cream: #FFF7EC;
    --paper: #FFFDF8;
    --sand: #EBD9BF;
    --sand-dark: #D6BC94;
    --wood: #B07A4A;
    --muted: #5B6B73;
    --money: #0E9F7E;
    --wave-beginner: #38B6D9;
    --wave-intermediate: #3D6BE0;
    --wave-pro: #B5179E;
}

.hidden {
    display: none;
}

.layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.hud-root,
.screen-overlay,
.menu-root,
.build-root,
.fish-root,
.bubble {
    -unity-font-definition: url("project://database/Assets/_Game/UI/Fonts/Fredoka%20SDF.asset");
}

/* Base icon size and tint (icons are white PNGs). Specific icons below override these, so keep this first. */
.title-row {
    flex-direction: row;
    align-items: center;
}

.icon {
    width: 20px;
    height: 20px;
    margin: 0 8px 4px 0;
    -unity-background-image-tint-color: var(--wood);
}

.icon--small {
    width: 18px;
    height: 18px;
    margin: 0 9px 0 0;
    -unity-background-image-tint-color: #8FA3AB;
}

/* Display font: titles, money, prices, buttons. Lilita has one weight, so never add bold to these. */
.money-label,
.screen-title,
.screen-money,
.menu-logo,
.mission-title,
.cost-chip,
.wave-type,
.tab,
.buy-button,
.send-button,
.close-button,
.segment,
.quality-button,
.level-badge,
.popup,
.key-badge,
.section-title,
.goal-name,
.report-totals,
.fish-status,
.price-stamp,
.shop-ticket-title,
.shop-ticket-price,
.shop-bubble-title,
.tab-badge {
    -unity-font-definition: url("project://database/Assets/_Game/UI/Fonts/Lilita%20SDF.asset");
    -unity-font-style: normal;
}

/* Hand-painted script: taglines and stickers only. */
.menu-tagline,
.window-tag,
.story-signature {
    -unity-font-definition: url("project://database/Assets/_Game/UI/Fonts/Pacifico%20SDF.asset");
    -unity-font-style: normal;
}

/* ---------- Shared pieces: cards, strips, chunky buttons ---------- */

.hud-root {
    flex-grow: 1;
}

.card {
    background-color: rgba(255, 247, 236, 0.96);
    border-radius: 18px;
    border-width: 2px;
    border-bottom-width: 6px;
    border-color: var(--sand-dark);
    padding: 12px 20px;
}

/* The ink "shop sign" across the top of a card. It bleeds into the card's padding. */
.card-strip {
    flex-direction: row;
    align-items: center;
    margin: -12px -20px 10px -20px;
    padding: 8px 20px 8px 16px;
    background-color: var(--ink);
    background-image: url("project://database/Assets/_Game/UI/Art/header_waves.png");
    background-repeat: repeat;
    background-size: 192px 48px;
    border-top-left-radius: 16px;
    border-top-right-radius: 16px;
}

.card-strip > .section-title {
    color: var(--cream);
    margin-bottom: 0;
}

.card-strip > .icon {
    -unity-background-image-tint-color: var(--sun);
    margin-bottom: 0;
}

.section-title {
    font-size: 17px;
    color: var(--wood);
    letter-spacing: 1.5px;
    margin-bottom: 6px;
}

.divider {
    height: 10px;
    margin: 10px 0;
    background-image: url("project://database/Assets/_Game/UI/Art/divider.png");
    background-repeat: repeat-x;
    background-size: 40px 10px;
    -unity-background-image-tint-color: var(--sand-dark);
}

/* ---------- HUD: status card (wallet, level, rating, clock) ---------- */

.top-left {
    position: absolute;
    left: 32px;
    top: 28px;
}

.top-left-row {
    flex-direction: row;
    align-items: flex-start;
}

.status-card {
    min-width: 290px;
}

.wallet {
    padding: 6px 22px 8px 10px;
}

.coin-badge {
    width: 46px;
    height: 46px;
    border-radius: 23px;
    background-color: var(--sun);
    border-width: 3px;
    border-color: var(--sun-dark);
    align-items: center;
    justify-content: center;
    margin-right: 12px;
}

.coin-icon {
    width: 30px;
    height: 30px;
    margin: 0;
    -unity-background-image-tint-color: var(--ink);
}

.money-label {
    font-size: 48px;
    color: var(--sun);
    text-shadow: 0 3px 0 rgba(0, 0, 0, 0.35);
    transition-property: scale;
    transition-duration: 0.12s;
    transition-timing-function: ease-out-back;
}

.money-label--negative {
    color: var(--coral);
}

.money-label--bump {
    scale: 1.12 1.12;
}

.income-rate {
    font-size: 16px;
    -unity-font-style: bold;
    color: var(--money);
    background-color: rgba(14, 159, 126, 0.12);
    border-radius: 10px;
    padding: 1px 10px;
    align-self: flex-start;
    margin-bottom: 6px;
}

.income-rate--negative {
    color: var(--coral);
    background-color: rgba(255, 107, 87, 0.12);
}

.level-row {
    flex-direction: row;
    align-items: center;
    margin: 2px 0 6px 0;
}

.level-badge {
    width: 40px;
    height: 40px;
    border-radius: 20px;
    background-color: var(--sun);
    border-width: 3px;
    border-color: var(--ink);
    color: var(--ink);
    font-size: 20px;
    -unity-text-align: middle-center;
    margin-right: 10px;
}

.level-info {
    flex-grow: 1;
    min-width: 170px;
}

.xp-label {
    font-size: 16px;
    color: var(--muted);
}

.xp-bar {
    height: 10px;
    margin-top: 3px;
    border-radius: 5px;
    border-width: 2px;
    border-color: var(--ink);
    background-color: var(--sand);
    overflow: hidden;
}

.xp-fill {
    height: 100%;
    background-color: var(--sun);
    transition-duration: 0.4s;
}

.rating-row {
    flex-direction: row;
    align-items: center;
    margin-top: 2px;
}

.star-rating {
    width: 150px;
    height: 28px;
}

.rating-label {
    font-size: 20px;
    -unity-font-style: bold;
    color: var(--ink);
    margin-left: 10px;
}

.day-row {
    flex-direction: row;
    align-items: center;
    margin-top: 6px;
}

.day-row > .icon {
    margin-bottom: 0;
    -unity-background-image-tint-color: var(--muted);
}

.day-label {
    font-size: 17px;
    -unity-font-style: bold;
    color: var(--ink-soft);
}

.event-label {
    font-size: 15px;
    -unity-font-style: bold;
    color: white;
    background-color: var(--orange);
    border-radius: 10px;
    border-width: 2px;
    border-color: var(--ink);
    padding: 2px 12px;
    margin-top: 8px;
    align-self: flex-start;
    rotate: -2deg;
}

.popup-stack {
    width: 320px;
    height: 40px;
    margin: 18px 0 0 14px;
}

.popup {
    position: absolute;
    left: 6px;
    top: 0;
    font-size: 26px;
    color: white;
    background-color: var(--money);
    border-radius: 12px;
    border-width: 2px;
    border-color: var(--ink);
    padding: 1px 12px 3px 12px;
    text-shadow: 0 2px 0 rgba(0, 0, 0, 0.25);
    transition-duration: 1.3s;
    transition-timing-function: ease-out;
}

.popup--negative {
    background-color: var(--coral);
}

.popup--leaving {
    opacity: 0;
    translate: 0 -48px;
}

/* ---------- HUD: wave machine + park panels (top right) ---------- */

.top-right {
    position: absolute;
    right: 32px;
    top: 28px;
    width: 370px;
}

.hud-panel {
    margin-bottom: 12px;
}

.wave-type {
    font-size: 24px;
    color: white;
    padding: 3px 14px 5px 14px;
    border-radius: 12px;
    border-width: 2px;
    border-color: var(--ink);
    align-self: flex-start;
    text-shadow: 0 2px 0 rgba(0, 0, 0, 0.25);
}

.wave-type--beginner {
    background-color: var(--wave-beginner);
}

.wave-type--intermediate {
    background-color: var(--wave-intermediate);
}

.wave-type--pro {
    background-color: var(--wave-pro);
}

.bar {
    height: 14px;
    background-color: var(--sand);
    border-radius: 7px;
    border-width: 2px;
    border-color: var(--ink);
    margin-top: 10px;
    overflow: hidden;
}

.bar-fill {
    height: 100%;
    background-color: var(--teal);
}

.bar-fill--charging {
    background-color: var(--sun);
}

.small-text {
    font-size: 16px;
    color: var(--muted);
    margin-top: 4px;
}

.small-text--alert {
    color: var(--coral);
    -unity-font-style: bold;
}

.stat-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-top: 5px;
}

.stat-name {
    font-size: 18px;
    color: var(--muted);
}

.stat-value {
    font-size: 18px;
    -unity-font-style: bold;
    color: var(--ink);
}

.stat-value--bad {
    color: var(--coral);
}

.stat-value--bill {
    color: var(--wood);
}

/* ---------- HUD: crosshair, [E] prompt, hints ---------- */

.crosshair {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 10px;
    height: 10px;
    margin-left: -5px;
    margin-top: -5px;
    border-radius: 5px;
    border-width: 2px;
    border-color: rgba(11, 46, 58, 0.7);
    background-color: white;
    transition-duration: 0.12s;
}

.crosshair--active {
    width: 24px;
    height: 24px;
    margin-left: -12px;
    margin-top: -12px;
    border-radius: 12px;
    border-width: 3px;
    border-color: var(--sun);
    background-color: rgba(255, 200, 87, 0.3);
}

.prompt {
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    margin-top: 38px;
    flex-direction: row;
    justify-content: center;
}

.prompt-box {
    flex-direction: row;
    align-items: center;
    background-color: var(--cream);
    border-radius: 16px;
    border-width: 3px;
    border-bottom-width: 6px;
    border-color: var(--ink);
    padding: 6px 20px 6px 8px;
}

/* A keyboard key: light cap, dark outline, thick bottom edge. */
.key-badge {
    min-width: 40px;
    height: 40px;
    border-radius: 10px;
    border-width: 2px;
    border-bottom-width: 5px;
    border-color: var(--ink);
    background-color: white;
    color: var(--ink);
    font-size: 22px;
    -unity-text-align: middle-center;
    padding: 0 6px;
    margin-right: 12px;
}

.prompt-label {
    font-size: 24px;
    -unity-font-style: bold;
    color: var(--ink);
}

.click-to-play {
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    margin-top: 36px;
    font-size: 32px;
    -unity-font-style: bold;
    color: white;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(11, 46, 58, 0.6);
}

.hint {
    position: absolute;
    left: 32px;
    bottom: 24px;
    font-size: 17px;
    -unity-font-style: bold;
    color: var(--cream);
    background-color: rgba(11, 46, 58, 0.72);
    border-radius: 14px;
    padding: 6px 16px;
    transition-duration: 1.5s;
}

.hint--hidden {
    opacity: 0;
}

/* ---------- Toasts: ink pill with a colored icon tile, slides down from the top ---------- */

.toasts {
    position: absolute;
    left: 0;
    right: 0;
    top: 24px;
    align-items: center;
}

.toast {
    flex-direction: row;
    align-items: center;
    background-color: rgba(11, 46, 58, 0.94);
    border-radius: 22px;
    border-width: 3px;
    border-bottom-width: 6px;
    border-color: var(--ink);
    padding: 6px 22px 6px 6px;
    margin-bottom: 8px;
    max-width: 900px;
    transition-property: opacity, translate, scale;
    transition-duration: 0.25s;
    transition-timing-function: ease-out-back;
}

.toast--entering {
    opacity: 0;
    translate: 0 -24px;
}

.toast--leaving {
    opacity: 0;
    translate: 0 -12px;
    transition-duration: 0.5s;
    transition-timing-function: ease-in;
}

.toast-tile {
    width: 34px;
    height: 34px;
    border-radius: 17px;
    background-color: var(--teal);
    align-items: center;
    justify-content: center;
    margin-right: 12px;
}

.toast-icon {
    width: 22px;
    height: 22px;
    margin: 0;
    -unity-background-image-tint-color: white;
}

.toast-text {
    font-size: 20px;
    color: var(--cream);
    white-space: normal;
    flex-shrink: 1;
}

/* The same message again: a sun chip counts it ("x3") and the pill gives a little bump. */
.toast-count {
    margin-left: 12px;
    padding: 0 9px 2px 9px;
    border-radius: 11px;
    background-color: var(--sun);
    color: var(--ink);
    font-size: 18px;
    -unity-font-definition: url("project://database/Assets/_Game/UI/Fonts/Lilita%20SDF.asset");
}

.toast--bump {
    scale: 1.05 1.05;
}

.toast--good .toast-tile {
    background-color: var(--money);
}

.toast--reward .toast-tile {
    background-color: var(--sun);
}

.toast--reward .toast-icon {
    -unity-background-image-tint-color: var(--ink);
}

.toast--bad {
    border-color: var(--coral-dark);
}

.toast--bad .toast-tile {
    background-color: var(--coral);
}

/* ---------- Surfer speech bubbles ---------- */

.bubble {
    position: absolute;
    align-items: center;
    translate: -50% -100%;
}

.bubble-box {
    flex-direction: row;
    align-items: center;
    background-color: white;
    border-radius: 16px;
    border-width: 2px;
    border-color: var(--ink);
    padding: 3px 12px 3px 3px;
}

.bubble-tail {
    width: 12px;
    height: 12px;
    background-color: white;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-color: var(--ink);
    rotate: 45deg;
    margin-top: -8px;
}

.skill-badge {
    width: 28px;
    height: 28px;
    border-radius: 14px;
    color: white;
    font-size: 15px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.skill-badge--beginner {
    background-color: var(--wave-beginner);
}

.skill-badge--intermediate {
    background-color: var(--wave-intermediate);
}

.skill-badge--pro {
    background-color: var(--wave-pro);
}

.bubble-text {
    font-size: 17px;
    -unity-font-style: bold;
    color: var(--ink);
    margin-left: 6px;
}

.patience {
    width: 74px;
    height: 10px;
    background-color: rgba(11, 46, 58, 0.55);
    border-radius: 5px;
    border-width: 2px;
    border-color: var(--ink);
    margin-top: 5px;
    overflow: hidden;
}

.patience-fill {
    height: 100%;
    background-color: #2BD9A0;
}

.patience-fill--mid {
    background-color: var(--sun);
}

.patience-fill--low {
    background-color: var(--coral);
}

/* ---------- Full-screen windows ("SurfOS tablet") ---------- */

.screen-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-image: url("project://database/Assets/_Game/UI/Art/backdrop.png");
    -unity-background-scale-mode: stretch-to-fill;
    align-items: center;
    justify-content: center;
    transition-property: opacity;
    transition-duration: 0.18s;
}

.screen-window {
    width: 1100px;
    height: 780px;
    background-color: var(--cream);
    border-radius: 28px;
    border-width: 4px;
    border-bottom-width: 12px;
    border-color: var(--ink);
    padding: 22px 30px 24px 30px;
    transition-property: scale, translate;
    transition-duration: 0.22s;
    transition-timing-function: ease-out-back;
}

/* UiMotion.Show adds this for one frame so the window pops in. */
.screen-overlay--enter {
    opacity: 0;
}

.screen-overlay--enter .screen-window {
    scale: 0.92 0.92;
    translate: 0 24px;
}

/* Closing (UiMotion.Hide): a quicker fade and a small shrink, ease-in, then .hidden. */
.screen-overlay--leave {
    opacity: 0;
    transition-duration: 0.14s;
    transition-timing-function: ease-in;
}

.screen-overlay--leave .screen-window {
    scale: 0.96 0.96;
    translate: 0 12px;
    transition-duration: 0.14s;
    transition-timing-function: ease-in;
}

/* The ink header strip of every window; bleeds into the window padding. */
.screen-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin: -22px -30px 0 -30px;
    padding: 20px 30px 16px 30px;
    background-color: var(--ink);
    background-image: url("project://database/Assets/_Game/UI/Art/header_waves.png");
    background-repeat: repeat;
    background-size: 256px 64px;
    border-top-left-radius: 24px;
    border-top-right-radius: 24px;
    flex-shrink: 0;
}

.screen-title {
    font-size: 42px;
    color: var(--cream);
    text-shadow: 0 3px 0 rgba(0, 0, 0, 0.4);
}

.screen-subtitle {
    font-size: 16px;
    color: var(--muted);
    white-space: normal;
}

.screen-header .screen-subtitle {
    color: var(--lagoon);
}

/* Little hand-painted sticker on the top edge of a window ("SurfOS", "Mail", ...). */
.window-tag {
    position: absolute;
    top: -26px;
    left: 34px;
    font-size: 22px;
    color: white;
    background-color: var(--coral);
    border-radius: 14px;
    border-width: 3px;
    border-color: var(--ink);
    padding: 0 16px 4px 16px;
    rotate: -4deg;
    text-shadow: 0 2px 0 rgba(0, 0, 0, 0.25);
}

.window-tag--teal {
    background-color: var(--teal);
}

.window-tag--sun {
    background-color: var(--sun);
    color: var(--ink);
    text-shadow: 0 0 0 rgba(0, 0, 0, 0);
}

/* Wallet pill in a window header. */
.screen-money {
    font-size: 34px;
    color: var(--ink);
    background-color: var(--sun);
    border-radius: 18px;
    border-width: 3px;
    border-bottom-width: 6px;
    border-color: var(--sun-dark);
    padding: 2px 20px 4px 20px;
}

.screen-footer {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    flex-shrink: 0;
    margin-top: 12px;
}

.screen-message {
    font-size: 18px;
    -unity-font-style: bold;
    color: var(--wood);
}

/* Footer legend chip: [Esc] Close, like a key on the counter. */
.key-legend {
    flex-direction: row;
    align-items: center;
}

.key-legend > .key-badge {
    min-width: 34px;
    height: 34px;
    font-size: 16px;
    margin-right: 8px;
}

.key-legend-text {
    font-size: 17px;
    -unity-font-style: bold;
    color: var(--muted);
    margin-right: 18px;
}

/* ---------- Chunky buttons (squash on press) ---------- */

.buy-button,
.send-button,
.close-button,
.segment,
.tab,
.quality-button {
    border-width: 3px;
    border-bottom-width: 7px;
    border-color: var(--ink);
    transition-property: scale, translate, background-color;
    transition-duration: 0.1s;
    transition-timing-function: ease-out;
}

.buy-button:hover,
.send-button:hover,
.close-button:hover,
.segment:hover,
.tab:hover,
.quality-button:hover {
    scale: 1.03 1.03;
}

/* Keyboard focus: a sun-colored edge (subtle, different from hover; mouse clicks drop focus again, see Sfx). */
.buy-button:focus,
.send-button:focus,
.close-button:focus,
.segment:focus,
.tab:focus,
.quality-button:focus {
    border-color: var(--sun-dark);
}

.buy-button:active,
.send-button:active,
.close-button:active,
.segment:active,
.tab:active,
.quality-button:active {
    scale: 0.96 0.96;
    translate: 0 3px;
}

.buy-button:disabled,
.send-button:disabled,
.segment:disabled,
.buy-button:disabled:hover,
.segment:disabled:hover {
    scale: 1 1;
    translate: 0 0;
}

/* A button with a key cap in it: [Esc] Close (like PowerWash's footer legend, but clickable). */
.key-button {
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.key-button > .key-badge {
    min-width: 32px;
    height: 32px;
    font-size: 15px;
    border-bottom-width: 4px;
    margin-right: 10px;
}

.key-button-text {
    font-size: 20px;
    color: var(--ink);
    padding: 0;
    margin: 0;
}

.send-button > .key-button-text {
    font-size: 28px;
    color: white;
}

.close-button {
    width: 180px;
    height: 52px;
    font-size: 20px;
    border-radius: 16px;
    background-color: white;
    color: var(--ink);
}

.close-button:hover {
    background-color: #FFF1DE;
}

.send-button {
    flex-grow: 1;
    height: 70px;
    margin: 0 14px 0 0;
    font-size: 30px;
    border-radius: 20px;
    background-color: var(--coral);
    color: white;
    text-shadow: 0 3px 0 rgba(0, 0, 0, 0.25);
}

.send-button:hover {
    background-color: #FF7F6D;
}

.send-button--charging,
.send-button--charging:hover {
    background-color: var(--sand);
    color: rgba(11, 46, 58, 0.45);
    border-color: var(--sand-dark);
    text-shadow: 0 0 0 rgba(0, 0, 0, 0);
    scale: 1 1;
}

/* ---------- Upgrade computer (SurfOS) ---------- */

.tabs {
    flex-direction: row;
    flex-shrink: 0;
    margin: 20px 0 14px 0;
}

.tab {
    flex-direction: row;
    align-items: center;
    font-size: 21px;
    color: var(--ink);
    background-color: white;
    border-radius: 16px;
    padding: 6px 20px 8px 12px;
    margin: 0 10px 0 0;
}

.tab:hover {
    background-color: #FFF1DE;
}

.tab-icon {
    width: 24px;
    height: 24px;
    margin: 0 8px 0 0;
    -unity-background-image-tint-color: var(--ink);
}

.tab--active,
.tab--active:hover {
    color: white;
    background-color: var(--teal);
    translate: 0 -3px;
    text-shadow: 0 2px 0 rgba(0, 0, 0, 0.25);
}

.tab-label {
    font-size: 21px;
    color: var(--ink);
    padding: 0;
    margin: 0;
}

.tab--active .tab-icon {
    -unity-background-image-tint-color: white;
}

.tab--active .tab-label {
    color: white;
}

.tab--waves.tab--active {
    background-color: var(--wave-intermediate);
}

.tab--pools.tab--active {
    background-color: var(--teal);
}

.tab--park.tab--active {
    background-color: #2FA36B;
}

.tab--rentals.tab--active {
    background-color: #E8A33D;
}

.tab--staff.tab--active {
    background-color: #C9578C;
}

/* Mail sits apart at the end of the row (it's a log, not a shop aisle). */
.tab--mail {
    margin-left: auto;
    margin-right: 0;
}

.tab--mail.tab--active {
    background-color: var(--ink-soft);
}

/* "2" = upgrades you can buy right now in that tab. */
.tab-badge {
    position: absolute;
    top: -12px;
    right: -10px;
    min-width: 26px;
    height: 26px;
    border-radius: 13px;
    border-width: 2px;
    border-color: var(--ink);
    background-color: var(--coral);
    color: white;
    font-size: 15px;
    -unity-text-align: middle-center;
    padding: 0 5px;
}

.cards {
    flex-grow: 1;
}

.card-row {
    flex-direction: row;
}

/* Shop scrollbar: sand track, rounded ink knob, no arrow buttons. */
.cards .unity-scroller--vertical {
    width: 16px;
    margin-left: 4px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

.cards .unity-scroller__low-button,
.cards .unity-scroller__high-button {
    display: none;
}

.cards .unity-scroller--vertical > .unity-scroller__slider {
    width: 16px;
    margin: 0;
}

.cards .unity-scroller--vertical .unity-base-slider__tracker {
    left: 0;
    right: 0;
    border-width: 0;
    border-radius: 8px;
    background-color: var(--sand);
}

.cards .unity-scroller--vertical .unity-base-slider__dragger {
    left: 2px;
    right: 2px;
    width: auto;
    border-width: 0;
    border-radius: 6px;
    background-color: var(--ink-soft);
}

.cards .unity-scroller--vertical .unity-base-slider__dragger-border {
    display: none;
}

.upgrade-card {
    width: 490px;
    margin: 0 12px 14px 0;
    background-color: var(--paper);
    border-radius: 20px;
    border-width: 2px;
    border-bottom-width: 6px;
    border-color: var(--sand-dark);
    padding: 14px 16px;
    transition-property: translate, border-color, scale, opacity;
    transition-duration: 0.12s, 0.12s, 0.1s, 0.2s;
    transition-timing-function: ease-out;
}

.upgrade-card--enter {
    opacity: 0;
    translate: 0 14px;
}

.upgrade-card--bought {
    scale: 1.03 1.03;
    border-color: var(--sun);
}

/* You can see which card the mouse is on: it lifts a little and its edge darkens. */
.upgrade-card:hover {
    translate: 0 -2px;
    border-color: var(--ink-soft);
}

.card-top {
    flex-direction: row;
    align-items: center;
    padding-right: 96px;
}

/* Colored round-square tile behind the white category icon. */
.icon-tile {
    width: 52px;
    height: 52px;
    border-radius: 16px;
    border-width: 3px;
    border-color: var(--ink);
    align-items: center;
    justify-content: center;
    margin-right: 12px;
    background-color: var(--teal);
}

.card-icon {
    width: 30px;
    height: 30px;
    margin: 0;
    -unity-background-image-tint-color: white;
}

.upgrade-card--waves .icon-tile {
    background-color: var(--wave-intermediate);
}

.upgrade-card--pools .icon-tile {
    background-color: var(--teal);
}

.upgrade-card--park .icon-tile {
    background-color: #2FA36B;
}

.upgrade-card--rentals .icon-tile {
    background-color: #E8A33D;
}

.upgrade-card--staff .icon-tile {
    background-color: #C9578C;
}

.card-title {
    font-size: 21px;
    -unity-font-style: bold;
    color: var(--ink);
    flex-grow: 1;
    flex-shrink: 1;
    white-space: normal;
}

/* Price tag pinned to the card's corner, a little crooked like a hand-stuck sticker. */
.cost-chip {
    position: absolute;
    top: 12px;
    right: 14px;
    font-size: 21px;
    color: var(--ink);
    background-color: var(--sun);
    border-radius: 12px;
    border-width: 3px;
    border-color: var(--ink);
    padding: 1px 12px 3px 12px;
    rotate: 3deg;
}

.cost-chip--short {
    background-color: var(--coral);
    color: white;
}

.card-desc {
    font-size: 16px;
    color: var(--muted);
    white-space: normal;
    margin-top: 8px;
    flex-grow: 1;
}

.card-requires {
    font-size: 16px;
    -unity-font-style: bold;
    color: var(--coral-dark);
    margin-top: 4px;
}

.buy-button {
    margin: 10px 0 0 0;
    height: 50px;
    font-size: 21px;
    border-radius: 16px;
    background-color: var(--teal);
    color: white;
    text-shadow: 0 2px 0 rgba(0, 0, 0, 0.25);
}

.buy-button:hover {
    background-color: #1FCAB7;
}

.buy-button--owned,
.buy-button--owned:hover {
    background-color: rgba(20, 184, 166, 0.1);
    border-color: rgba(20, 184, 166, 0.35);
    color: var(--teal-dark);
    text-shadow: 0 0 0 rgba(0, 0, 0, 0);
}

.buy-button--blocked,
.buy-button--blocked:hover {
    background-color: var(--sand);
    border-color: var(--sand-dark);
    color: rgba(11, 46, 58, 0.5);
    text-shadow: 0 0 0 rgba(0, 0, 0, 0);
}

/* Owned upgrades sink to the bottom, fade back, and get a stamp instead of a price. */
.upgrade-card--owned {
    background-color: #F4FBF8;
    border-color: #CFEAE0;
}

.upgrade-card--owned .card-title,
.upgrade-card--owned .card-desc,
.upgrade-card--owned .icon-tile {
    opacity: 0.6;
}

.price-stamp {
    position: absolute;
    top: 14px;
    right: 14px;
    font-size: 18px;
    letter-spacing: 2px;
    color: var(--teal-dark);
    border-width: 3px;
    border-color: var(--teal-dark);
    border-radius: 8px;
    padding: 0 10px 2px 10px;
    rotate: -8deg;
    opacity: 0.85;
    transition-property: scale, rotate, opacity;
    transition-duration: 0.2s;
    transition-timing-function: ease-in;
}

/* Just bought: starts big, faint and twisted, and slams down onto the card (UiMotion.Enter). */
.price-stamp--slam {
    scale: 2.2 2.2;
    rotate: -20deg;
    opacity: 0;
}

.card-stars {
    flex-direction: row;
    align-items: center;
    margin-top: 6px;
}

.card-stars-text {
    font-size: 16px;
    color: var(--wood);
    margin-left: 6px;
}

.card-stars > .staff-star {
    width: 18px;
    height: 18px;
    margin: 0 2px 0 0;
    -unity-background-image-tint-color: var(--sun-dark);
}

.card-stars > .staff-star--empty {
    width: 18px;
    height: 18px;
    margin: 0 2px 0 0;
    -unity-background-image-tint-color: #E6DCCB;
}

/* ---------- Wave Control panel ---------- */

.wave-window {
    width: 1000px;
    height: auto;
}

.section-gap {
    margin-top: 18px;
}

.wave-cards {
    flex-direction: row;
}

.wave-card {
    flex-grow: 1;
    flex-basis: 0;
    margin-right: 14px;
    background-color: var(--paper);
    border-radius: 20px;
    border-width: 3px;
    border-bottom-width: 8px;
    border-color: var(--sand-dark);
    padding: 0 16px 16px 16px;
    overflow: hidden;
    transition-property: translate, border-color, background-color;
    transition-duration: 0.12s;
}

.wave-card--last {
    margin-right: 0;
}

.wave-card:hover {
    border-color: var(--ink-soft);
}

.wave-card--selected,
.wave-card--selected:hover {
    border-color: var(--ink);
    background-color: #FFF4D6;
    translate: 0 -6px;
}

.wave-card--locked {
    opacity: 0.5;
}

/* In a wave card, the wave name becomes the card's colored header band. */
.wave-card > .wave-type {
    align-self: stretch;
    margin: 0 -16px 0 -16px;
    padding: 10px 16px 12px 16px;
    border-radius: 0;
    border-width: 0;
    border-bottom-width: 3px;
    font-size: 28px;
    -unity-text-align: middle-center;
}

.wave-card-text {
    font-size: 16px;
    color: var(--muted);
    margin-top: 12px;
    white-space: normal;
}

.wave-card-waiting {
    font-size: 17px;
    -unity-font-style: bold;
    color: var(--money);
    background-color: rgba(14, 159, 126, 0.12);
    border-radius: 10px;
    padding: 2px 10px;
    margin-top: 12px;
    align-self: flex-start;
}

.wave-card-locked {
    font-size: 15px;
    color: var(--coral-dark);
    margin-top: 10px;
    white-space: normal;
}

.segment-row {
    flex-direction: row;
}

.segment {
    flex-grow: 1;
    flex-basis: 0;
    height: 58px;
    font-size: 20px;
    border-radius: 16px;
    margin: 0 10px 0 0;
    background-color: white;
    color: var(--ink);
}

.segment:hover {
    background-color: #FFF1DE;
}

.segment--selected,
.segment--selected:hover {
    background-color: var(--teal);
    color: white;
    translate: 0 -3px;
    text-shadow: 0 2px 0 rgba(0, 0, 0, 0.25);
}

.segment:disabled {
    background-color: var(--sand);
    border-color: var(--sand-dark);
}

/* ---------- Missions and challenges (HUD, left) ---------- */

.mission-card {
    width: 380px;
    margin-top: 12px;
}

.mission-title {
    font-size: 25px;
    color: var(--ink);
}

.mission-story {
    font-size: 16px;
    color: var(--muted);
    white-space: normal;
    margin-top: 4px;
}

.mission-objectives {
    margin-top: 8px;
}

.objective-row {
    flex-direction: row;
    align-items: center;
    margin-top: 5px;
}

.objective-check {
    width: 20px;
    height: 20px;
    border-radius: 6px;
    border-width: 2px;
    border-bottom-width: 4px;
    border-color: var(--ink);
    background-color: white;
    margin-right: 9px;
}

.objective-check--done {
    background-color: var(--teal);
}

.objective-text {
    font-size: 17px;
    color: var(--ink);
    white-space: normal;
    flex-shrink: 1;
}

.objective-text--done {
    color: var(--muted);
}

.mission-hint {
    font-size: 16px;
    color: var(--wood);
    white-space: normal;
    margin-top: 8px;
}

.mission-marker {
    position: absolute;
    align-items: center;
    translate: -50% -100%;
}

.marker-diamond {
    width: 24px;
    height: 24px;
    rotate: 45deg;
    background-color: var(--sun);
    border-width: 3px;
    border-color: var(--ink);
    border-radius: 5px;
}

.marker-distance {
    font-size: 16px;
    -unity-font-style: bold;
    color: white;
    background-color: rgba(11, 46, 58, 0.8);
    border-radius: 8px;
    padding: 0 8px 1px 8px;
    margin-top: 8px;
}

.mission-banner {
    position: absolute;
    left: 0;
    right: 0;
    top: 22%;
    -unity-text-align: middle-center;
    font-size: 48px;
    -unity-font-definition: url("project://database/Assets/_Game/UI/Fonts/Lilita%20SDF.asset");
    -unity-font-style: normal;
    color: var(--sun);
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: var(--ink);
    text-shadow: 0 4px 0 rgba(11, 46, 58, 0.8);
    transition-duration: 0.6s;
}

.mission-banner--leaving {
    opacity: 0;
    translate: 0 -30px;
}

.challenge-card {
    padding: 12px 20px;
}

.challenge-header {
    margin-bottom: 2px;
}

.challenge-title {
    margin-bottom: 0;
}

.challenge-reward {
    font-size: 15px;
    -unity-font-style: bold;
    color: var(--money);
    margin: 0 0 2px 0;
}

/* ---------- Next-goal strip (bottom center) ---------- */

.goal-strip {
    position: absolute;
    bottom: 22px;
    left: 50%;
    width: 660px;
    margin-left: -330px;
    padding: 10px 18px 12px 12px;
}

.goal-header {
    flex-direction: row;
    align-items: center;
}

.goal-tile {
    width: 34px;
    height: 34px;
    border-radius: 11px;
    border-width: 2px;
    border-color: var(--ink);
    background-color: var(--coral);
    align-items: center;
    justify-content: center;
    margin-right: 10px;
}

.goal-tile > .icon {
    width: 20px;
    height: 20px;
    margin: 0;
    -unity-background-image-tint-color: white;
}

.goal-kicker {
    margin: 0 12px 0 0;
}

.goal-name {
    flex-grow: 1;
    font-size: 21px;
    color: var(--ink);
}

.goal-amount {
    font-size: 17px;
    -unity-font-style: bold;
    color: var(--muted);
}

.goal-bar {
    margin-top: 8px;
}

.goal-fill {
    background-color: var(--sun);
    transition-duration: 0.3s;
}

.goal-strip--plan .goal-kicker {
    color: var(--coral);
}

.goal-strip--ready {
    border-color: var(--teal-dark);
}

.goal-strip--ready .goal-tile {
    background-color: var(--teal);
}

.goal-strip--ready .goal-fill {
    background-color: var(--teal);
}

.goal-strip--ready .goal-amount {
    color: var(--teal-dark);
}

/* ---------- Story letter ---------- */

.story-window {
    width: 820px;
    height: auto;
}

.story-body {
    font-size: 20px;
    color: var(--ink);
    white-space: normal;
    margin-top: 18px;
}

.story-signature {
    font-size: 30px;
    color: var(--coral);
    margin-top: 12px;
}

.story-button {
    margin: 22px 0 0 0;
    flex-grow: 0;
}

/* ---------- End-of-day report and pause menu ---------- */

.report-window {
    width: 1220px;
    height: auto;
}

.report-columns {
    flex-direction: row;
}

.report-column {
    flex-grow: 1;
    flex-basis: 0;
    background-color: var(--paper);
    border-radius: 18px;
    border-width: 2px;
    border-bottom-width: 5px;
    border-color: var(--sand-dark);
    padding: 14px 18px;
    margin-right: 14px;
}

.report-column--last {
    margin-right: 0;
}

.report-name {
    font-size: 18px;
    color: var(--muted);
}

.report-value {
    font-size: 18px;
    -unity-font-style: bold;
    color: var(--ink);
}

.report-empty {
    font-size: 16px;
    color: var(--muted);
}

/* Guest reviews: little paper notes with stars, the line, and who said it. */
.report-column--reviews {
    flex-grow: 1.35;
}

.review-card {
    background-color: white;
    border-radius: 12px;
    border-width: 2px;
    border-bottom-width: 4px;
    border-color: var(--sand-dark);
    padding: 8px 12px 9px 12px;
    margin-bottom: 8px;
}

.review-card--bad {
    border-color: #F2B3A9;
}

.review-stars {
    font-size: 17px;
    color: var(--sun-dark);
    letter-spacing: 2px;
}

.review-card--bad .review-stars {
    color: var(--coral);
}

.review-text {
    font-size: 16px;
    color: var(--ink);
    white-space: normal;
    margin-top: 2px;
}

.review-who {
    font-size: 15px;
    color: var(--muted);
    -unity-text-align: upper-right;
    margin-top: 2px;
}

.report-facts {
    margin-top: 4px;
}

.report-fact {
    font-size: 16px;
    color: var(--ink-soft);
    white-space: normal;
}

/* The report plays out (DayReportScreen): each row, review and the totals wait hidden, then slide in. */
.report-beat--waiting {
    opacity: 0;
    translate: -12px 0;
}

.report-columns .stat-row,
.review-card,
.report-facts,
.report-totals,
.report-empty {
    transition-property: opacity, translate;
    transition-duration: 0.22s;
    transition-timing-function: ease-out;
}

.review-card {
    rotate: -1.5deg;
}

.review-card.report-beat--waiting {
    translate: 0 -16px;
}

.report-totals {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-top: 16px;
}

/* Income and Spent as two quiet chips, then the day's profit as a big slammed number. */
.report-chip {
    font-size: 24px;
    -unity-font-definition: url("project://database/Assets/_Game/UI/Fonts/Lilita%20SDF.asset");
    color: var(--ink-soft);
    background-color: var(--paper);
    border-radius: 14px;
    border-width: 2px;
    border-bottom-width: 5px;
    border-color: var(--sand-dark);
    padding: 4px 16px 6px 16px;
    margin-right: 14px;
}

.report-chip--spent {
    color: var(--coral-dark);
}

.report-profit-box {
    flex-direction: row;
    align-items: center;
    margin-left: 10px;
}

.report-profit-label {
    margin: 0 12px 0 0;
}

.report-profit {
    font-size: 56px;
    -unity-font-definition: url("project://database/Assets/_Game/UI/Fonts/Lilita%20SDF.asset");
    color: white;
    background-color: var(--money);
    border-radius: 22px;
    border-width: 3px;
    border-bottom-width: 8px;
    border-color: var(--ink);
    padding: 0 26px 6px 26px;
    text-shadow: 0 3px 0 rgba(0, 0, 0, 0.25);
    rotate: -2deg;
    transition-property: scale, opacity, rotate;
    transition-duration: 0.35s, 0.2s, 0.35s;
    transition-timing-function: ease-out-back, ease-out, ease-out-back;
}

.report-profit--loss {
    background-color: var(--coral);
}

.report-profit--slam {
    scale: 1.35 1.35;
    rotate: -9deg;
}

.pause-text {
    font-size: 16px;
    color: var(--ink);
    white-space: normal;
}

.pause-button {
    width: 136px;
    margin-left: 8px;
    font-size: 18px;
}

.volume-row {
    flex-direction: row;
    align-items: center;
    background-color: var(--paper);
    border-radius: 18px;
    border-width: 2px;
    border-bottom-width: 5px;
    border-color: var(--sand-dark);
    padding: 10px 18px;
}

.volume-title {
    margin: 0 18px 0 0;
}

.volume-slider {
    flex-grow: 1;
    flex-basis: 0;
    margin: 0 14px 0 0;
}

.volume-slider > .unity-label {
    font-size: 18px;
    color: var(--ink);
    min-width: 70px;
}

/* Sliders: sand track with ink outline, sun-yellow knob. */
.volume-slider .unity-base-slider__tracker,
.settings-slider .unity-base-slider__tracker {
    height: 12px;
    margin-top: -6px;
    border-radius: 6px;
    border-width: 2px;
    border-color: var(--ink);
    background-color: var(--sand);
}

.volume-slider .unity-base-slider__dragger,
.settings-slider .unity-base-slider__dragger {
    width: 26px;
    height: 26px;
    margin-top: -13px;
    border-radius: 13px;
    border-width: 3px;
    border-color: var(--ink);
    background-color: var(--sun);
}

/* ---------- Main menu: a retro surf poster ---------- */

.menu-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    justify-content: center;
    padding-left: 90px;
    background-image: url("project://database/Assets/_Game/UI/Art/backdrop.png");
    -unity-background-scale-mode: stretch-to-fill;
}

.menu-poster {
    position: absolute;
    right: 7%;
    top: 50%;
    width: 640px;
    height: 640px;
    margin-top: -320px;
    background-image: url("project://database/Assets/_Game/UI/Art/poster.png");
    -unity-background-scale-mode: scale-to-fit;
    rotate: 4deg;
    transition-property: scale, rotate, opacity;
    transition-duration: 0.6s;
    transition-timing-function: ease-out-back;
}

.menu-panel {
    width: 540px;
    background-color: var(--cream);
    border-radius: 30px;
    border-width: 4px;
    border-bottom-width: 12px;
    border-color: var(--ink);
    padding: 34px 40px 26px 40px;
    transition-property: translate, opacity;
    transition-duration: 0.45s;
    transition-timing-function: ease-out-back;
}

.menu-root--enter .menu-panel {
    translate: -80px 0;
    opacity: 0;
}

.menu-root--enter .menu-poster {
    scale: 0.7 0.7;
    rotate: -12deg;
    opacity: 0;
}

.menu-logo {
    font-size: 80px;
    color: var(--ink);
    letter-spacing: 1px;
    text-shadow: 0 6px 0 var(--coral);
    -unity-text-align: upper-left;
}

.menu-tagline {
    font-size: 34px;
    color: var(--teal-dark);
    margin-top: -14px;
    rotate: -3deg;
    align-self: flex-start;
    padding-left: 6px;
}

.menu-wave {
    height: 14px;
    margin: 14px 0 18px 0;
    background-image: url("project://database/Assets/_Game/UI/Art/divider.png");
    background-repeat: repeat-x;
    background-size: 56px 14px;
    -unity-background-image-tint-color: var(--teal);
}

.menu-save {
    font-size: 17px;
    -unity-font-style: bold;
    color: var(--muted);
    margin-bottom: 12px;
}

.menu-button {
    flex-grow: 0;
    width: 100%;
    height: 66px;
    margin: 0 0 12px 0;
    font-size: 28px;
}

.menu-button--light {
    height: 56px;
    font-size: 22px;
}

.menu-button--danger {
    border-color: var(--coral-dark);
    color: var(--coral-dark);
}

.menu-footer {
    font-size: 15px;
    color: var(--muted);
    margin-top: 10px;
}

/* ---------- Settings ---------- */

.settings-window {
    width: 720px;
    height: auto;
}

.settings-window .report-column {
    margin-right: 0;
    flex-grow: 0;
    flex-basis: auto;
}

.settings-slider,
.settings-toggle {
    margin: 6px 0;
}

.settings-slider > .unity-label,
.settings-toggle > .unity-label,
.settings-label {
    font-size: 18px;
    color: var(--ink);
    min-width: 200px;
}

.settings-toggle .unity-toggle__checkmark {
    width: 26px;
    height: 26px;
    border-radius: 8px;
    border-width: 2px;
    border-bottom-width: 4px;
    border-color: var(--ink);
    background-color: white;
}

.settings-toggle:checked .unity-toggle__checkmark {
    background-color: var(--teal);
    -unity-background-image-tint-color: white;
}

.quality-row {
    flex-direction: row;
    align-items: center;
    margin: 6px 0;
}

.quality-button {
    flex-grow: 1;
    height: 46px;
    margin: 0 8px 0 0;
    font-size: 18px;
    border-radius: 14px;
    background-color: white;
    color: var(--ink);
}

.quality-button--active,
.quality-button--active:hover {
    background-color: var(--teal);
    color: white;
}

/* ---------- Build mode ---------- */

.build-root {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 18px;
    align-items: center;
}

.build-panel {
    padding: 12px 14px 12px 14px;
}

.build-header {
    flex-direction: row;
    align-items: center;
    margin: -12px -14px 10px -14px;
    padding: 8px 16px;
    background-color: var(--ink);
    border-top-left-radius: 16px;
    border-top-right-radius: 16px;
}

.build-kicker {
    margin: 0 14px 0 0;
    color: var(--sun);
}

.build-info {
    font-size: 15px;
    color: var(--lagoon);
}

.build-items {
    flex-direction: row;
}

.build-card {
    width: 148px;
    margin-right: 8px;
    padding: 8px 10px;
    background-color: white;
    border-radius: 14px;
    border-width: 2px;
    border-bottom-width: 5px;
    border-color: var(--sand-dark);
}

.build-card--selected {
    border-color: var(--ink);
    background-color: #E6FBF7;
    translate: 0 -4px;
}

.build-card--expensive {
    opacity: 0.5;
}

.build-key {
    position: absolute;
    right: 8px;
    top: 6px;
    font-size: 16px;
    -unity-font-style: bold;
    color: var(--muted);
}

.build-title {
    font-size: 16px;
    -unity-font-style: bold;
    color: var(--ink);
    white-space: normal;
    margin-right: 14px;
}

.build-price {
    font-size: 16px;
    color: var(--money);
    -unity-font-style: bold;
    margin-top: 2px;
}

.build-beauty {
    font-size: 15px;
    color: var(--wood);
}

/* ---------- Fishing ---------- */

.fish-root {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 120px;
    align-items: center;
}

.fish-panel {
    width: 560px;
    padding: 12px 22px 16px 22px;
}

.fish-panel > .section-title {
    margin: -12px -22px 10px -22px;
    padding: 8px 22px;
    color: var(--sun);
    background-color: var(--ink);
    border-top-left-radius: 16px;
    border-top-right-radius: 16px;
}

.fish-status {
    font-size: 28px;
    color: var(--ink);
    white-space: normal;
}

.fish-bar {
    height: 18px;
    border-radius: 9px;
    margin: 4px 0 8px 0;
}

.fish-tension {
    background-color: var(--sun);
}

.fish-tension--danger {
    background-color: var(--coral);
}

.fish-hint {
    font-size: 16px;
    color: var(--muted);
    white-space: normal;
    margin-top: 4px;
}

/* ---------- Icons (tools/ui/make_icons.py: white shapes, tinted here) ---------- */

.stat-row > .stat-name {
    flex-grow: 1;
}

.icon--wave {
    background-image: url("project://database/Assets/_Game/UI/Icons/wave.png");
}

.icon--palm {
    background-image: url("project://database/Assets/_Game/UI/Icons/palm.png");
}

.icon--target {
    background-image: url("project://database/Assets/_Game/UI/Icons/target.png");
}

.icon--pin {
    background-image: url("project://database/Assets/_Game/UI/Icons/pin.png");
}

.icon--mail {
    background-image: url("project://database/Assets/_Game/UI/Icons/mail.png");
}

.icon--meh {
    background-image: url("project://database/Assets/_Game/UI/Icons/meh.png");
}

.icon--flag {
    background-image: url("project://database/Assets/_Game/UI/Icons/flag.png");
}

.icon--pool {
    background-image: url("project://database/Assets/_Game/UI/Icons/pool.png");
}

.icon--board {
    background-image: url("project://database/Assets/_Game/UI/Icons/board.png");
}

.icon--person {
    background-image: url("project://database/Assets/_Game/UI/Icons/person.png");
}

.icon--tag {
    background-image: url("project://database/Assets/_Game/UI/Icons/tag.png");
}

.icon--smile {
    background-image: url("project://database/Assets/_Game/UI/Icons/smile.png");
}

.icon--frown {
    background-image: url("project://database/Assets/_Game/UI/Icons/frown.png");
}

.icon--trash {
    background-image: url("project://database/Assets/_Game/UI/Icons/trash.png");
}

.icon--bolt {
    background-image: url("project://database/Assets/_Game/UI/Icons/bolt.png");
}

.icon--star {
    background-image: url("project://database/Assets/_Game/UI/Icons/star.png");
}

.icon--clock {
    background-image: url("project://database/Assets/_Game/UI/Icons/clock.png");
}

.icon--coin {
    background-image: url("project://database/Assets/_Game/UI/Icons/coin.png");
}

/* Celebration banner */

.celebration {
    position: absolute;
    left: 0;
    right: 0;
    top: 28%;
    align-items: center;
    transition-property: opacity, scale, translate;
    transition-duration: 0.45s, 0.45s, 0.45s;
    transition-timing-function: ease-out-back, ease-out-back, ease-out-back;
}

.celebration--enter {
    opacity: 0;
    scale: 0.4 0.4;
    translate: 0 40px;
}

.celebration--leaving {
    opacity: 0;
    translate: 0 -40px;
    transition-timing-function: ease-in, ease-in, ease-in;
}

.celebration-title {
    font-size: 84px;
    -unity-font-definition: url("project://database/Assets/_Game/UI/Fonts/Lilita%20SDF.asset");
    -unity-font-style: normal;
    -unity-text-align: middle-center;
    color: var(--sun);
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: var(--ink);
    text-shadow: 0 6px 0 rgba(11, 46, 58, 0.85);
    rotate: -3deg;
}

.celebration-ribbon {
    margin-top: 2px;
    padding: 8px 34px 10px 34px;
    max-width: 70%;
    white-space: normal;
    font-size: 26px;
    -unity-font-definition: url("project://database/Assets/_Game/UI/Fonts/Lilita%20SDF.asset");
    -unity-font-style: normal;
    -unity-text-align: middle-center;
    color: var(--cream);
    background-color: var(--coral);
    border-width: 3px;
    border-color: var(--ink);
    border-radius: 10px;
    rotate: -1.5deg;
}

.celebration--big .celebration-title {
    font-size: 104px;
}

.celebration--big .celebration-ribbon {
    background-color: var(--teal);
    font-size: 30px;
}


/* ---------- Surf HUD (SurfHud.cs): ride panel, flow bar, combo, call-outs, lens drops, score card ---------- */

.surf-panel {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 104px;
    align-items: center;
}

.surf-panel-box {
    align-items: center;
    min-width: 270px;
    padding: 4px 22px 10px 22px;
    background-color: rgba(11, 46, 58, 0.8);
    border-width: 3px;
    border-color: var(--ink);
    border-radius: 16px;
}

.surf-score {
    font-size: 40px;
    color: var(--sun);
    -unity-font-definition: url("project://database/Assets/_Game/UI/Fonts/Lilita%20SDF.asset");
    -unity-font-style: normal;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: var(--ink);
}

.surf-flow {
    width: 230px;
    height: 12px;
    margin-top: 2px;
    background-color: rgba(255, 247, 236, 0.16);
    border-radius: 6px;
    overflow: hidden;
}

.surf-flow-fill {
    height: 100%;
    width: 0;
    background-color: var(--teal);
    border-radius: 6px;
    transition-property: background-color;
    transition-duration: 0.3s;
}

.surf-flow-fill--hot {
    background-color: var(--orange);
}

.surf-flow-label {
    margin-top: 2px;
    font-size: 15px;
    letter-spacing: 3px;
    color: var(--lagoon);
    -unity-font-definition: url("project://database/Assets/_Game/UI/Fonts/Lilita%20SDF.asset");
    -unity-font-style: normal;
}

.surf-combo {
    margin-top: 4px;
    font-size: 22px;
    color: var(--cream);
    -unity-font-definition: url("project://database/Assets/_Game/UI/Fonts/Lilita%20SDF.asset");
    -unity-font-style: normal;
}

.surf-combo-timer {
    height: 4px;
    width: 0;
    max-width: 230px;
    margin-top: 2px;
    background-color: var(--sun);
    border-radius: 2px;
}

.surf-call {
    position: absolute;
    left: 0;
    right: 0;
    top: 22%;
    -unity-text-align: middle-center;
    font-size: 46px;
    color: var(--sun);
    -unity-font-definition: url("project://database/Assets/_Game/UI/Fonts/Lilita%20SDF.asset");
    -unity-font-style: normal;
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: var(--ink);
    text-shadow: 0 5px 0 rgba(11, 46, 58, 0.85);
    rotate: -2deg;
    opacity: 0;
    scale: 0.8 0.8;
    transition-property: opacity, scale;
    transition-duration: 0.2s, 0.25s;
    transition-timing-function: ease-out, ease-out-back;
}

.surf-call--shown {
    opacity: 1;
    scale: 1 1;
}

.surf-call--pop {
    scale: 1.3 1.3;
}

.surf-call--info {
    font-size: 30px;
    color: var(--cream);
}

/* Tricks: a wax sticker (cream paper, ink edge, chunky bottom) centered on screen, tilted per call (SurfHud). */
.surf-call--sticker {
    left: 50%;
    right: auto;
    translate: -50% 0;
    background-color: var(--paper);
    border-radius: 22px;
    border-width: 3px;
    border-bottom-width: 7px;
    border-color: var(--ink);
    padding: 2px 26px 8px 26px;
    -unity-text-outline-width: 0;
    text-shadow: 0 0 0 rgba(0, 0, 0, 0);
    white-space: nowrap;
}

.surf-call--sticker.surf-call--good {
    color: var(--teal-dark);
}

.surf-call--sticker.surf-call--reward {
    color: var(--coral-dark);
    background-color: var(--sun);
}

.surf-call--small {
    font-size: 34px;
}

.surf-call--mid {
    font-size: 46px;
}

.surf-call--big {
    font-size: 62px;
    border-bottom-width: 9px;
}

.surf-call--good {
    color: var(--lagoon);
}

.surf-call--reward {
    color: var(--sun);
}

.surf-call--bad {
    color: var(--coral);
}

.surf-drops {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.surf-drop {
    position: absolute;
    border-radius: 999px;
    background-color: rgba(214, 244, 255, 0.16);
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.5);
}

.surf-drop-shine {
    position: absolute;
    left: 22%;
    top: 18%;
    width: 26%;
    height: 22%;
    border-radius: 999px;
    background-color: rgba(255, 255, 255, 0.7);
}

.surf-card {
    position: absolute;
    left: 0;
    right: 0;
    top: 30%;
    align-items: center;
    opacity: 0;
    scale: 0.6 0.6;
    transition-property: opacity, scale;
    transition-duration: 0.3s, 0.4s;
    transition-timing-function: ease-out, ease-out-back;
}

.surf-card--shown {
    opacity: 1;
    scale: 1 1;
}

.surf-card-box {
    align-items: center;
    padding: 10px 34px 14px 34px;
    background-color: var(--cream);
    border-width: 4px;
    border-bottom-width: 9px;
    border-color: var(--ink);
    border-radius: 18px;
    rotate: -1.5deg;
}

.surf-card-rating {
    font-size: 54px;
    color: var(--coral);
    -unity-font-definition: url("project://database/Assets/_Game/UI/Fonts/Lilita%20SDF.asset");
    -unity-font-style: normal;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: var(--ink);
}

.surf-card-score {
    font-size: 40px;
    color: var(--ink);
    -unity-font-definition: url("project://database/Assets/_Game/UI/Fonts/Lilita%20SDF.asset");
    -unity-font-style: normal;
}

.surf-card-details {
    font-size: 18px;
    color: var(--muted);
}

/* The judges' 0-10 score, like a surf contest scoreboard. */
.surf-card-judges {
    font-size: 30px;
    color: white;
    background-color: var(--ink);
    border-radius: 12px;
    padding: 2px 16px 4px 16px;
    margin-top: 6px;
    -unity-font-definition: url("project://database/Assets/_Game/UI/Fonts/Lilita%20SDF.asset");
    -unity-font-style: normal;
}

.surf-card-judges--great {
    background-color: var(--teal);
}

.surf-card-praise {
    font-size: 16px;
    color: var(--ink-soft);
    margin-top: 4px;
}


/* ---------- Level preview under the XP bar ---------- */

.level-next {
    margin-top: 3px;
    font-size: 15px;
    color: var(--teal-dark);
    white-space: normal;
    max-width: 250px;
}

/* ---------- Upgrade card stickers: PLAN (what Kai's plan wants) and NEW (just unlocked) ---------- */

.card-sticker {
    position: absolute;
    top: 40px;
    right: 14px;
    padding: 2px 10px 3px 10px;
    font-size: 15px;
    color: var(--cream);
    border-width: 2px;
    border-color: var(--ink);
    border-radius: 8px;
    rotate: 5deg;
    -unity-font-definition: url("project://database/Assets/_Game/UI/Fonts/Lilita%20SDF.asset");
    -unity-font-style: normal;
}

.card-sticker--plan {
    background-color: var(--coral);
}

.card-sticker--new {
    background-color: var(--teal);
}

/* ---------- Perk picker (PerkPicker.cs) ---------- */

.perk-window {
    align-items: center;
    width: 1040px;
}

.perk-title {
    font-size: 64px;
    color: var(--sun);
    -unity-font-definition: url("project://database/Assets/_Game/UI/Fonts/Lilita%20SDF.asset");
    -unity-font-style: normal;
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: var(--ink);
    text-shadow: 0 6px 0 rgba(11, 46, 58, 0.85);
    rotate: -2deg;
}

.perk-ribbon {
    margin-top: 2px;
    padding: 6px 30px 8px 30px;
    font-size: 24px;
    color: var(--cream);
    background-color: var(--teal);
    border-width: 3px;
    border-color: var(--ink);
    border-radius: 10px;
    rotate: -1deg;
    -unity-font-definition: url("project://database/Assets/_Game/UI/Fonts/Lilita%20SDF.asset");
    -unity-font-style: normal;
}

.perk-cards {
    flex-direction: row;
    justify-content: center;
    margin-top: 30px;
}

.perk-card {
    width: 300px;
    min-height: 300px;
    margin: 0 14px;
    padding: 22px 22px 18px 22px;
    align-items: center;
    background-color: var(--cream);
    border-width: 4px;
    border-bottom-width: 11px;
    border-color: var(--ink);
    border-radius: 22px;
    transition-property: translate, scale, border-color, background-color;
    transition-duration: 0.35s, 0.15s, 0.15s, 0.15s;
    transition-timing-function: ease-out-back, ease-out, ease-out, ease-out;
}

.perk-card--1 {
    transition-delay: 0.08s, 0s, 0s, 0s;
}

.perk-card--2 {
    transition-delay: 0.16s, 0s, 0s, 0s;
}

.screen-overlay--enter .perk-card {
    translate: 0 60px;
}

.perk-card:hover {
    scale: 1.04 1.04;
    border-color: var(--teal-dark);
    background-color: var(--paper);
}

.perk-card:active {
    scale: 0.97 0.97;
    border-bottom-width: 6px;
}

.perk-tile {
    width: 92px;
    height: 92px;
    align-items: center;
    justify-content: center;
    background-color: var(--lagoon);
    border-width: 3px;
    border-color: var(--ink);
    border-radius: 20px;
    rotate: -4deg;
}

.perk-icon {
    width: 54px;
    height: 54px;
    margin: 0;
    -unity-background-image-tint-color: var(--ink);
}

.perk-name {
    margin-top: 16px;
    font-size: 28px;
    color: var(--ink);
    -unity-text-align: middle-center;
    white-space: normal;
    -unity-font-definition: url("project://database/Assets/_Game/UI/Fonts/Lilita%20SDF.asset");
    -unity-font-style: normal;
}

.perk-text {
    margin-top: 8px;
    font-size: 19px;
    color: var(--muted);
    -unity-text-align: middle-center;
    white-space: normal;
    flex-grow: 1;
}

.perk-key {
    margin-top: 12px;
    width: 38px;
    height: 38px;
    font-size: 20px;
    -unity-text-align: middle-center;
    color: var(--cream);
    background-color: var(--ink);
    border-radius: 10px;
    -unity-font-definition: url("project://database/Assets/_Game/UI/Fonts/Lilita%20SDF.asset");
    -unity-font-style: normal;
}

.perk-more {
    margin-top: 26px;
    padding: 6px 18px 7px 18px;
    font-size: 18px;
    color: var(--cream);
    background-color: rgba(11, 46, 58, 0.82);
    border-radius: 12px;
}


/* ---------- Shop customers: order bubbles and the order ticket ---------- */

.shop-bubble-box {
    flex-direction: column;
    align-items: center;
    padding: 5px 10px 6px 10px;
}

.shop-bubble-say {
    margin-left: 0;
    white-space: normal;
    max-width: 260px;
    -unity-text-align: middle-center;
}

.shop-bubble-title {
    font-size: 17px;
    color: var(--ink);
}

.bubble-chips {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    max-width: 300px;
    margin-top: 2px;
}

.bubble-chip,
.ticket-chip {
    flex-direction: row;
    align-items: center;
    background-color: var(--cream);
    border-radius: 10px;
    border-width: 2px;
    border-color: var(--sand-dark);
    padding: 1px 8px 1px 4px;
    margin: 2px;
}

.bubble-chip--done,
.ticket-chip--done {
    opacity: 0.45;
    border-color: var(--teal);
}

.order-dot {
    width: 12px;
    height: 12px;
    border-radius: 6px;
    border-width: 2px;
    border-color: var(--ink);
    margin-right: 4px;
}

.order-chip-label {
    font-size: 14px;
    color: var(--ink);
    -unity-font-style: bold;
}

.shop-ticket {
    position: absolute;
    right: 32px;
    top: 52%;
    width: 330px;
}

.shop-ticket-head {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.shop-ticket-title {
    font-size: 24px;
    color: var(--ink);
}

.shop-ticket-price {
    font-size: 22px;
    color: var(--money);
}

.shop-ticket-items {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 6px;
}

.ticket-chip .order-chip-label {
    font-size: 16px;
}

.shop-ticket-hint {
    font-size: 16px;
    color: var(--ink-soft);
    white-space: normal;
    margin-top: 8px;
    -unity-font-style: bold;
}

.shop-ticket-bar {
    margin-top: 8px;
}

/* Ring around the crosshair while holding E (blend, shape, repair). */
.hold-ring {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 78px;
    height: 78px;
    translate: -50% -50%;
}

/* "+$18" rising from a shop counter on each sale. */
.cash-pop {
    position: absolute;
    translate: -50% -100%;
    font-size: 30px;
    color: var(--sun);
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: var(--ink);
    -unity-font-definition: url("project://database/Assets/_Game/UI/Fonts/Lilita%20SDF.asset");
}

.cash-pop--tip {
    font-size: 20px;
    color: var(--lagoon);
}

/* An order modifier ("In a hurry!", "Big tipper") on bubbles and the ticket. */
.order-mood {
    font-size: 14px;
    color: white;
    background-color: var(--coral);
    border-radius: 8px;
    padding: 1px 8px;
    margin-top: 2px;
    -unity-font-style: bold;
}

.order-mood--good {
    background-color: var(--money);
}

/* A visiting legend: gold bubble and star badge. */
.bubble--famous .bubble-box {
    border-color: var(--sun-dark);
    border-width: 3px;
    background-color: #FFF4D6;
}

.bubble--famous .skill-badge {
    background-color: var(--sun-dark);
    color: white;
}

/* ---------- Instant replay ---------- */

.hud-root--replay > * {
    display: none;
}

.hud-root--replay > .replay-overlay {
    display: flex;
}

.replay-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    justify-content: space-between;
}

.replay-bar {
    height: 11%;
    background-color: rgba(4, 14, 18, 0.92);
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 0 48px;
}

.replay-title {
    font-size: 40px;
    color: var(--coral);
    -unity-font-definition: url("project://database/Assets/_Game/UI/Fonts/Lilita%20SDF.asset");
    letter-spacing: 6px;
}

.replay-hint {
    font-size: 18px;
    color: var(--cream);
}

.replay-slow {
    position: absolute;
    top: 14%;
    right: 48px;
    font-size: 26px;
    color: var(--sun);
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: var(--ink);
    -unity-font-definition: url("project://database/Assets/_Game/UI/Fonts/Lilita%20SDF.asset");
}

.replay-offer {
    position: absolute;
    bottom: 22%;
    left: 50%;
    translate: -50% 0;
    font-size: 22px;
    color: var(--cream);
    background-color: rgba(11, 46, 58, 0.85);
    border-radius: 14px;
    border-width: 2px;
    border-color: var(--sun);
    padding: 6px 18px;
    -unity-font-definition: url("project://database/Assets/_Game/UI/Fonts/Lilita%20SDF.asset");
}

/* ---------- Surf photographer: the viewfinder ---------- */

.hud-root--photo > * {
    display: none;
}

.hud-root--photo > .viewfinder {
    display: flex;
}

.viewfinder {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.vf-corner {
    position: absolute;
    width: 70px;
    height: 70px;
    border-color: rgba(255, 255, 255, 0.85);
}

.vf-corner--tl { left: 8%; top: 10%; border-left-width: 4px; border-top-width: 4px; }
.vf-corner--tr { right: 8%; top: 10%; border-right-width: 4px; border-top-width: 4px; }
.vf-corner--bl { left: 8%; bottom: 10%; border-left-width: 4px; border-bottom-width: 4px; }
.vf-corner--br { right: 8%; bottom: 10%; border-right-width: 4px; border-bottom-width: 4px; }

.vf-focus {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 120px;
    height: 80px;
    translate: -50% -50%;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.6);
    border-radius: 6px;
}

.vf-zoom {
    position: absolute;
    right: 9%;
    top: 12%;
    font-size: 24px;
    color: white;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: var(--ink);
    -unity-font-definition: url("project://database/Assets/_Game/UI/Fonts/Lilita%20SDF.asset");
}

.vf-help {
    position: absolute;
    bottom: 5%;
    left: 50%;
    translate: -50% 0;
    font-size: 17px;
    color: var(--cream);
    background-color: rgba(11, 46, 58, 0.7);
    border-radius: 10px;
    padding: 4px 14px;
}

.vf-flash {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(255, 255, 255, 0.85);
}

/* The polaroid that pops up after a shot, with the grade stamp. */
.vf-photo {
    position: absolute;
    right: 6%;
    bottom: 14%;
    width: 360px;
    padding: 12px 12px 10px 12px;
    background-color: var(--paper);
    border-radius: 6px;
    border-width: 2px;
    border-color: var(--ink);
    rotate: -3deg;
}

.vf-photo--enter {
    scale: 0.7 0.7;
    opacity: 0;
}

.vf-photo {
    transition-property: scale, opacity;
    transition-duration: 0.18s;
}

.vf-photo-image {
    height: 210px;
    background-color: var(--ink);
    -unity-background-scale-mode: scale-and-crop;
}

.vf-reason {
    font-size: 18px;
    color: var(--ink);
    margin-top: 8px;
    -unity-font-style: bold;
}

.vf-grade {
    position: absolute;
    right: -18px;
    top: -22px;
    width: 72px;
    height: 72px;
    border-radius: 36px;
    font-size: 44px;
    -unity-text-align: middle-center;
    color: white;
    background-color: var(--muted);
    border-width: 3px;
    border-color: var(--ink);
    rotate: 12deg;
    -unity-font-definition: url("project://database/Assets/_Game/UI/Fonts/Lilita%20SDF.asset");
}

.vf-grade--b { background-color: var(--teal); }
.vf-grade--a { background-color: var(--wave-intermediate); }
.vf-grade--s { background-color: var(--sun-dark); }

/* ---------- Name your park (ParkNamer) ---------- */

.name-window {
    width: 760px;
    height: auto;
}

.name-intro {
    font-size: 19px;
    color: var(--ink);
    white-space: normal;
    margin-top: 16px;
}

/* A little painted sign preview, like the one at the gate. */
.name-board {
    align-items: center;
    margin: 18px 0 6px 0;
}

.name-board-sign {
    width: 560px;
    padding: 14px 20px 12px 20px;
    align-items: center;
    background-color: var(--teal);
    border-radius: 18px;
    border-width: 4px;
    border-bottom-width: 9px;
    border-color: var(--ink);
}

.name-preview {
    font-size: 44px;
    color: white;
    -unity-font-definition: url("project://database/Assets/_Game/UI/Fonts/Lilita%20SDF.asset");
    text-shadow: 0 3px 0 rgba(0, 0, 0, 0.3);
    -unity-text-align: middle-center;
    white-space: nowrap;
}

.name-preview-small {
    font-size: 15px;
    color: var(--cream);
    letter-spacing: 4px;
    margin-top: 2px;
}

.name-board-posts {
    width: 420px;
    height: 26px;
    flex-direction: row;
    justify-content: space-between;
}

.name-board-post {
    width: 16px;
    background-color: var(--wood);
    border-left-width: 3px;
    border-right-width: 3px;
    border-bottom-width: 3px;
    border-color: var(--ink);
}

.name-field {
    margin: 10px 0 0 0;
}

.name-field > .unity-base-text-field__input,
.name-field > .unity-text-field__input {
    height: 58px;
    font-size: 28px;
    color: var(--ink);
    -unity-font-definition: url("project://database/Assets/_Game/UI/Fonts/Lilita%20SDF.asset");
    -unity-text-align: middle-center;
    background-color: var(--paper);
    border-radius: 16px;
    border-width: 3px;
    border-color: var(--ink);
    padding: 0 14px;
}

.name-ideas-row {
    flex-direction: row;
    align-items: center;
    margin-top: 14px;
}

.name-ideas-label {
    font-size: 22px;
    color: var(--coral);
    -unity-font-definition: url("project://database/Assets/_Game/UI/Fonts/Pacifico%20SDF.asset");
    margin-right: 10px;
}

.name-ideas {
    flex-direction: row;
    flex-grow: 1;
    flex-wrap: wrap;
}

.name-idea {
    height: 40px;
    font-size: 16px;
    color: var(--ink);
    background-color: white;
    border-radius: 20px;
    border-width: 3px;
    border-bottom-width: 5px;
    border-color: var(--ink);
    padding: 0 14px;
    margin: 0 8px 0 0;
    -unity-font-definition: url("project://database/Assets/_Game/UI/Fonts/Lilita%20SDF.asset");
}

.name-idea:hover {
    background-color: var(--lagoon);
}

.name-reroll {
    width: 130px;
    height: 40px;
    font-size: 16px;
    border-bottom-width: 5px;
}

.name-cost {
    font-size: 16px;
    color: var(--muted);
    margin-top: 14px;
}

.name-buttons {
    flex-direction: row;
    align-items: center;
    margin-top: 12px;
}

.name-cancel {
    width: 200px;
    height: 70px;
    margin-right: 14px;
}

.name-ok {
    margin: 0;
}

/* ---------- Rush hour (SurfRush): campers served and time left, above the goal strip ---------- */

.rush-pill {
    position: absolute;
    bottom: 116px;
    left: 50%;
    width: 360px;
    margin-left: -180px;
    -unity-text-align: middle-center;
    font-size: 22px;
    color: white;
    -unity-font-definition: url("project://database/Assets/_Game/UI/Fonts/Lilita%20SDF.asset");
    background-color: var(--coral);
    border-radius: 20px;
    border-width: 3px;
    border-bottom-width: 6px;
    border-color: var(--ink);
    padding: 4px 16px 6px 16px;
    text-shadow: 0 2px 0 rgba(0, 0, 0, 0.25);
}

.rush-pill--late {
    background-color: var(--muted);
}

/* ---------- While surfing: keep the view clear (money, the wave machine and the surf HUD stay) ---------- */

.hud-root--surfing .mission-card,
.hud-root--surfing .goal-strip,
.hud-root--surfing .park-panel {
    display: none;
}

/* ---------- Sets and lulls (WaveMachine sets, WaveWater.Chop): "SET INCOMING", one pip per wave, then the lull ---------- */

.set-call {
    position: absolute;
    left: 0;
    right: 0;
    top: 13%;
    align-items: center;
    transition-property: opacity, translate, scale;
    transition-duration: 0.3s, 0.3s, 0.3s;
    transition-timing-function: ease-out-back, ease-out-back, ease-out-back;
}

.set-call--out {
    opacity: 0;
    translate: 0 -24px;
    scale: 0.85 0.85;
}

.set-title {
    font-size: 38px;
    -unity-font-definition: url("project://database/Assets/_Game/UI/Fonts/Lilita%20SDF.asset");
    color: white;
    background-color: var(--wave-intermediate);
    border-radius: 22px;
    border-width: 3px;
    border-bottom-width: 7px;
    border-color: var(--ink);
    padding: 2px 26px 6px 26px;
    letter-spacing: 2px;
    text-shadow: 0 3px 0 rgba(0, 0, 0, 0.3);
    transition-property: background-color, scale;
    transition-duration: 0.25s, 0.18s;
    transition-timing-function: ease-out, ease-out-back;
}

.set-title--lull {
    font-size: 26px;
    background-color: var(--teal-dark);
    letter-spacing: 1px;
}

.set-title--pulse {
    scale: 1.08 1.08;
}

.set-pips {
    flex-direction: row;
    margin-top: -4px;
}

.set-pip {
    width: 26px;
    height: 16px;
    margin: 0 4px;
    border-radius: 8px;
    border-width: 3px;
    border-color: var(--ink);
    background-color: var(--cream);
    transition-property: background-color, scale, translate;
    transition-duration: 0.25s, 0.25s, 0.25s;
    transition-timing-function: ease-out-back, ease-out-back, ease-out-back;
}

.set-pip--fired {
    background-color: var(--sun);
    scale: 1.2 1.2;
    translate: 0 3px;
}

.set-note {
    margin-top: 6px;
    font-size: 18px;
    color: var(--cream);
    -unity-font-style: bold;
    background-color: rgba(11, 46, 58, 0.88);
    border-radius: 12px;
    padding: 2px 14px 4px 14px;
}

.water-line--glassy {
    color: var(--teal-dark);
    -unity-font-style: bold;
}

.water-line--choppy {
    color: var(--coral);
    -unity-font-style: bold;
}

/* ---------- Tooltips (UI/Tooltip.cs): a small ink pill above the cursor ---------- */
.tooltip {
    position: absolute;
    max-width: 320px;
    padding: 7px 12px 8px 12px;
    background-color: var(--ink);
    color: var(--cream);
    font-size: 16px;
    white-space: normal;
    border-radius: 10px;
    border-width: 2px;
    border-color: var(--sun);
    -unity-font-definition: url("project://database/Assets/_Game/UI/Fonts/Fredoka%20SDF.asset");
}

/* ---------- Mail tab (UpgradeScreen): recent messages, newest first ---------- */
.mail-row {
    margin: 0 4px 8px 4px;
    padding: 8px 14px 10px 14px;
    background-color: var(--paper);
    border-radius: 12px;
    border-width: 2px 2px 4px 8px;
    border-color: var(--sand-dark);
    transition-property: opacity, translate;
    transition-duration: 0.22s, 0.22s;
    transition-timing-function: ease-out, ease-out;
}

.mail-row--good {
    border-left-color: var(--teal);
}

.mail-row--reward {
    border-left-color: var(--sun);
}

.mail-row--bad {
    border-left-color: var(--coral);
}

.mail-when {
    font-size: 14px;
    color: var(--muted);
}

.mail-text {
    font-size: 17px;
    color: var(--ink);
    white-space: normal;
}

.mail-empty {
    margin: 24px;
    font-size: 18px;
    color: var(--muted);
    white-space: normal;
    -unity-text-align: middle-center;
}
