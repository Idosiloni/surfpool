<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="Game.uss" />
    <ui:VisualElement name="fishRoot" class="fish-root hidden" picking-mode="Ignore">
        <ui:VisualElement class="card fish-panel" picking-mode="Ignore">
            <ui:Label text="FISHING" class="section-title" picking-mode="Ignore" />
            <ui:Label name="fishStatus" class="fish-status" picking-mode="Ignore" />
            <ui:VisualElement name="fishBars" class="hidden" picking-mode="Ignore">
                <ui:Label text="Line tension" class="small-text" picking-mode="Ignore" />
                <ui:VisualElement class="bar fish-bar" picking-mode="Ignore">
                    <ui:VisualElement name="tensionFill" class="bar-fill fish-tension" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:Label text="Reeling in" class="small-text" picking-mode="Ignore" />
                <ui:VisualElement class="bar fish-bar" picking-mode="Ignore">
                    <ui:VisualElement name="reelFill" class="bar-fill" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Label name="fishHint" class="fish-hint" picking-mode="Ignore" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
