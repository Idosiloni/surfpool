<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="Game.uss" />
    <ui:VisualElement name="waveRoot" class="screen-overlay hidden">
        <ui:VisualElement class="screen-window wave-window">
            <ui:VisualElement class="screen-header">
                <ui:VisualElement>
                    <ui:Label text="Wave Control" class="screen-title" />
                    <ui:Label text="Pick a wave, then SEND it (or press the big red button)." class="screen-subtitle" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Label text="Machine house" class="window-tag" />

            <ui:Label text="WAVE" class="section-title section-gap" />
            <ui:VisualElement name="waveCards" class="wave-cards" />

            <ui:VisualElement name="directionSection">
                <ui:Label text="DIRECTION" class="section-title section-gap" />
                <ui:VisualElement name="directionRow" class="segment-row" />
                <ui:Label name="directionHint" class="screen-subtitle" />
            </ui:VisualElement>

            <ui:VisualElement name="shapeSection">
                <ui:Label text="SHAPE" class="section-title section-gap" />
                <ui:VisualElement name="shapeRow" class="segment-row" />
                <ui:Label name="shapeHint" class="screen-subtitle" />
            </ui:VisualElement>

            <ui:VisualElement name="setSection">
                <ui:Label text="SET" class="section-title section-gap" />
                <ui:VisualElement name="setRow" class="segment-row" />
                <ui:Label name="setHint" class="screen-subtitle" />
            </ui:VisualElement>

            <ui:VisualElement name="famousSection">
                <ui:Label text="FAMOUS WAVES" class="section-title section-gap" />
                <ui:VisualElement name="famousRow" class="segment-row" />
                <ui:Label name="famousHint" class="screen-subtitle" />
            </ui:VisualElement>

            <ui:VisualElement class="screen-footer section-gap">
                <ui:Button name="sendButton" text="SEND WAVE" class="send-button" />
                <ui:Button name="waveCloseButton" class="close-button key-button">
                    <ui:Label text="Esc" class="key-badge" />
                    <ui:Label text="Close" class="key-button-text" />
                </ui:Button>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
