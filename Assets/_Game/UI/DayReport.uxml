<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="Game.uss" />
    <ui:VisualElement name="reportRoot" class="screen-overlay hidden">
        <ui:VisualElement class="screen-window report-window">
            <ui:VisualElement class="screen-header">
                <ui:VisualElement>
                    <ui:Label name="reportTitle" text="Day 1 is over!" class="screen-title" />
                    <ui:Label name="reportSummary" class="screen-subtitle" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Label text="Closing time" class="window-tag" />
            <ui:VisualElement class="report-columns section-gap">
                <ui:VisualElement class="report-column">
                    <ui:Label text="INCOME" class="section-title" />
                    <ui:VisualElement name="incomeRows" />
                </ui:VisualElement>
                <ui:VisualElement class="report-column">
                    <ui:Label text="EXPENSES" class="section-title" />
                    <ui:VisualElement name="expenseRows" />
                </ui:VisualElement>
                <ui:VisualElement class="report-column report-column--last report-column--reviews">
                    <ui:Label text="WHAT GUESTS SAID" class="section-title" />
                    <ui:VisualElement name="reviewCards" />
                    <ui:VisualElement name="factRows" class="report-facts" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="reportTotals" class="report-totals">
                <ui:Label name="totalIncome" class="report-chip report-chip--income" />
                <ui:Label name="totalSpent" class="report-chip report-chip--spent" />
                <ui:VisualElement class="report-profit-box">
                    <ui:Label text="PROFIT" class="section-title report-profit-label" />
                    <ui:Label name="totalProfit" class="report-profit" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Button name="reportNext" text="Save &amp; start the next day" class="send-button story-button" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
