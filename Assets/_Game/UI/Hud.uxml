<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="Game.uss" />
    <ui:VisualElement name="hudRoot" class="hud-root" picking-mode="Ignore">
        <ui:VisualElement name="bubbleLayer" class="layer" picking-mode="Ignore" />

        <ui:VisualElement class="top-left" picking-mode="Ignore">
            <ui:VisualElement class="top-left-row" picking-mode="Ignore">
            <ui:VisualElement class="card status-card" picking-mode="Ignore">
                <ui:VisualElement class="card-strip wallet" picking-mode="Ignore">
                    <ui:VisualElement class="coin-badge" picking-mode="Ignore">
                        <ui:VisualElement class="icon icon--coin coin-icon" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:Label name="moneyLabel" text="$ 0" class="money-label" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:Label name="incomeRate" text="+$0 / min" class="income-rate" picking-mode="Ignore" />
                <ui:VisualElement class="level-row" picking-mode="Ignore">
                    <ui:Label name="levelLabel" text="1" class="level-badge" picking-mode="Ignore" />
                    <ui:VisualElement class="level-info" picking-mode="Ignore">
                        <ui:Label name="xpLabel" text="60 XP to level 2" class="xp-label" picking-mode="Ignore" />
                        <ui:VisualElement class="xp-bar" picking-mode="Ignore">
                            <ui:VisualElement name="xpFill" class="xp-fill" picking-mode="Ignore" />
                        </ui:VisualElement>
                        <ui:Label name="levelNext" class="level-next" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="rating-row" picking-mode="Ignore">
                    <ui:VisualElement name="ratingStarsSlot" picking-mode="Ignore" />
                    <ui:Label name="ratingLabel" text="3.5" class="rating-label" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement class="day-row" picking-mode="Ignore">
                    <ui:VisualElement class="icon icon--clock" picking-mode="Ignore" />
                    <ui:Label name="dayLabel" text="Day 1 · 8:00 AM" class="day-label" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:Label name="eventLabel" text="Today: Heat Wave" class="event-label hidden" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement name="popupStack" class="popup-stack" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement name="challengeCard" class="card mission-card challenge-card hidden" picking-mode="Ignore">
                <ui:VisualElement class="title-row card-strip" picking-mode="Ignore">
                    <ui:VisualElement class="icon icon--target" picking-mode="Ignore" />
                    <ui:Label text="TODAY'S CHALLENGES" class="section-title challenge-title" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:Label name="challengeReward" class="challenge-reward" picking-mode="Ignore" />
                <ui:VisualElement name="challengeList" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement name="missionCard" class="card mission-card hidden" picking-mode="Ignore">
                <ui:VisualElement class="title-row card-strip" picking-mode="Ignore">
                    <ui:VisualElement class="icon icon--pin" picking-mode="Ignore" />
                    <ui:Label name="missionChapter" class="section-title" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:Label name="missionTitle" class="mission-title" picking-mode="Ignore" />
                <ui:Label name="missionStory" class="mission-story" picking-mode="Ignore" />
                <ui:VisualElement name="missionObjectives" class="mission-objectives" picking-mode="Ignore" />
                <ui:Label name="missionHint" class="mission-hint" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>

        <SurfPool.HoldRing name="holdRing" class="hold-ring hidden" />
        <ui:Label name="replayOffer" text="R  Watch replay" class="replay-offer hidden" picking-mode="Ignore" />
        <ui:VisualElement name="replayOverlay" class="replay-overlay hidden" picking-mode="Ignore">
            <ui:VisualElement class="replay-bar" picking-mode="Ignore" />
            <ui:Label name="replaySlow" text="SLOW-MO" class="replay-slow hidden" picking-mode="Ignore" />
            <ui:VisualElement class="replay-bar replay-bar--bottom" picking-mode="Ignore">
                <ui:Label text="REPLAY" class="replay-title" picking-mode="Ignore" />
                <ui:Label text="Space  skip" class="replay-hint" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="cashPopLayer" class="layer" picking-mode="Ignore" />

        <ui:VisualElement name="shopTicket" class="card shop-ticket hidden" picking-mode="Ignore">
            <ui:VisualElement class="title-row card-strip" picking-mode="Ignore">
                <ui:VisualElement class="icon icon--tag" picking-mode="Ignore" />
                <ui:Label name="shopTicketShop" class="section-title" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement class="shop-ticket-head" picking-mode="Ignore">
                <ui:Label name="shopTicketTitle" class="shop-ticket-title" picking-mode="Ignore" />
                <ui:Label name="shopTicketPrice" class="shop-ticket-price" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:Label name="shopTicketMood" class="order-mood hidden" picking-mode="Ignore" />
            <ui:VisualElement name="shopTicketItems" class="shop-ticket-items" picking-mode="Ignore" />
            <ui:Label name="shopTicketHint" class="shop-ticket-hint" picking-mode="Ignore" />
            <ui:VisualElement name="shopTicketBar" class="bar shop-ticket-bar hidden" picking-mode="Ignore">
                <ui:VisualElement name="shopTicketFill" class="bar-fill" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement class="top-right" picking-mode="Ignore">
            <ui:VisualElement name="wavePanel" class="card hud-panel" picking-mode="Ignore">
                <ui:VisualElement class="title-row card-strip" picking-mode="Ignore">
                    <ui:VisualElement class="icon icon--wave" picking-mode="Ignore" />
                    <ui:Label text="WAVE MACHINE" class="section-title" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:Label name="waveType" text="Intermediate" class="wave-type wave-type--intermediate" picking-mode="Ignore" />
                <ui:VisualElement class="bar" picking-mode="Ignore">
                    <ui:VisualElement name="waveBarFill" class="bar-fill" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:Label name="waveStatus" text="Ready" class="small-text" picking-mode="Ignore" />
                <ui:Label name="waveAuto" text="Auto: off" class="small-text" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement class="card hud-panel" picking-mode="Ignore">
                <ui:VisualElement class="title-row card-strip" picking-mode="Ignore">
                    <ui:VisualElement class="icon icon--palm" picking-mode="Ignore" />
                    <ui:Label text="PARK" class="section-title" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement class="stat-row" picking-mode="Ignore">
                    <ui:VisualElement class="icon icon--small icon--tag" picking-mode="Ignore" />
                    <ui:Label text="Session prices" class="stat-name" picking-mode="Ignore" />
                    <ui:Label name="ticketValue" text="$20" class="stat-value" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement name="rentalRow" class="stat-row hidden" picking-mode="Ignore">
                    <ui:VisualElement class="icon icon--small icon--board" picking-mode="Ignore" />
                    <ui:Label text="Board rental" class="stat-name" picking-mode="Ignore" />
                    <ui:Label name="rentalValue" text="$10" class="stat-value" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement name="servedRow" class="stat-row hidden" picking-mode="Ignore">
                    <ui:VisualElement class="icon icon--small icon--smile" picking-mode="Ignore" />
                    <ui:Label text="Happy surfers" class="stat-name" picking-mode="Ignore" />
                    <ui:Label name="servedValue" text="0" class="stat-value" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement name="lostRow" class="stat-row hidden" picking-mode="Ignore">
                    <ui:VisualElement class="icon icon--small icon--frown" picking-mode="Ignore" />
                    <ui:Label text="Lost customers" class="stat-name" picking-mode="Ignore" />
                    <ui:Label name="lostValue" text="0" class="stat-value" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement name="trashRow" class="stat-row hidden" picking-mode="Ignore">
                    <ui:VisualElement class="icon icon--small icon--trash" picking-mode="Ignore" />
                    <ui:Label text="Trash on the ground" class="stat-name" picking-mode="Ignore" />
                    <ui:Label name="trashValue" text="0" class="stat-value" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement name="billsRow" class="stat-row" picking-mode="Ignore">
                    <ui:VisualElement class="icon icon--small icon--bolt" picking-mode="Ignore" />
                    <ui:Label text="Today's bills" class="stat-name" picking-mode="Ignore" />
                    <ui:Label name="billsValue" text="$0" class="stat-value stat-value--bill" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement name="wagesRow" class="stat-row hidden" picking-mode="Ignore">
                    <ui:VisualElement class="icon icon--small icon--person" picking-mode="Ignore" />
                    <ui:Label text="Staff wages" class="stat-name" picking-mode="Ignore" />
                    <ui:Label name="wagesValue" text="$0/min" class="stat-value" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="missionMarker" class="mission-marker hidden" picking-mode="Ignore">
            <ui:VisualElement class="marker-diamond" picking-mode="Ignore" />
            <ui:Label name="markerDistance" class="marker-distance" picking-mode="Ignore" />
        </ui:VisualElement>

        <ui:Label name="missionBanner" class="mission-banner hidden" picking-mode="Ignore" />

        <ui:VisualElement name="celebrationBanner" class="celebration hidden" picking-mode="Ignore">
            <ui:Label name="celebrationTitle" class="celebration-title" picking-mode="Ignore" />
            <ui:Label name="celebrationSubtitle" class="celebration-ribbon" picking-mode="Ignore" />
        </ui:VisualElement>

        <ui:VisualElement name="goalStrip" class="goal-strip card hidden" picking-mode="Ignore">
            <ui:VisualElement class="goal-header" picking-mode="Ignore">
                <ui:VisualElement class="goal-tile" picking-mode="Ignore">
                    <ui:VisualElement class="icon icon--flag" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:Label name="goalKicker" text="NEXT GOAL" class="section-title goal-kicker" picking-mode="Ignore" />
                <ui:Label name="goalName" class="goal-name" picking-mode="Ignore" />
                <ui:Label name="goalAmount" class="goal-amount" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement class="bar goal-bar" picking-mode="Ignore">
                <ui:VisualElement name="goalFill" class="bar-fill goal-fill" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="toasts" class="toasts" picking-mode="Ignore" />

        <ui:VisualElement name="crosshair" class="crosshair" picking-mode="Ignore" />
        <ui:VisualElement name="prompt" class="prompt" picking-mode="Ignore">
            <ui:VisualElement class="prompt-box" picking-mode="Ignore">
                <ui:Label text="E" class="key-badge" picking-mode="Ignore" />
                <ui:Label name="promptLabel" text="Use" class="prompt-label" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:Label name="clickToPlay" text="Click to play" class="click-to-play hidden" picking-mode="Ignore" />

        <!-- Surfing: lens drops, call-outs, ride panel and score card (SurfHud) -->
        <ui:VisualElement name="surfDrops" class="surf-drops" picking-mode="Ignore" />
        <ui:Label name="surfCall" class="surf-call" picking-mode="Ignore" />
        <ui:VisualElement name="surfPanel" class="surf-panel hidden" picking-mode="Ignore">
            <ui:VisualElement class="surf-panel-box" picking-mode="Ignore">
                <ui:Label name="surfScore" text="0" class="surf-score" picking-mode="Ignore" />
                <ui:VisualElement class="surf-flow" picking-mode="Ignore">
                    <ui:VisualElement name="surfFlowFill" class="surf-flow-fill" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:Label text="FLOW" class="surf-flow-label" picking-mode="Ignore" />
                <ui:Label name="surfCombo" class="surf-combo hidden" picking-mode="Ignore" />
                <ui:VisualElement name="surfComboTimer" class="surf-combo-timer hidden" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="surfCard" class="surf-card" picking-mode="Ignore">
            <ui:VisualElement class="surf-card-box" picking-mode="Ignore">
                <ui:Label name="surfCardRating" class="surf-card-rating" picking-mode="Ignore" />
                <ui:Label name="surfCardScore" class="surf-card-score" picking-mode="Ignore" />
                <ui:Label name="surfCardDetails" class="surf-card-details" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:Label name="hint" text="WASD move   ·   Shift sprint   ·   Space jump   ·   E use   ·   Esc free mouse" class="hint" picking-mode="Ignore" />

        <!-- Level-up perk pick (PerkPicker) -->
        <ui:VisualElement name="perkPicker" class="screen-overlay perk-overlay hidden">
            <ui:VisualElement class="perk-window">
                <ui:Label name="perkTitle" text="Park level 2!" class="perk-title" />
                <ui:Label text="Pick a perk for your park" class="perk-ribbon" />
                <ui:VisualElement name="perkCards" class="perk-cards" />
                <ui:Label name="perkMore" class="perk-more" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
