--- !u!114 &1178742118
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1178742117}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 49d4a24889feb488ea98d78ae8f7c571, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SurfPool.UpgradeShop
  upgrades:
  - id: pool_expand_1
    category: 1
    title: Pool Expansion I
    description: Dig the main pool out to 50 x 19 m. Room for 2 more surfers, and big enough for Intermediate waves.
    cost: 400
    level: 3
    requires: 
  - id: pool_expand_2
    category: 1
    title: Pool Expansion II
    description: 'The main pool''s full size: 60 x 24 m. Room for 2 more surfers, and big enough for Pro waves.'
    cost: 3000
    level: 10
    requires: intermediate_waves
  - id: pool_reef
    category: 1
    title: Build the Reef Pool
    description: A second pool north of the main one. Longer peeling waves. Room for 4 more surfers, and every session there costs 2.5x.
    cost: 18000
    level: 15
    requires: pool_expand_2
  - id: pool_lagoon
    category: 1
    title: Build the Big Wave Lagoon
    description: The biggest, deepest pool in the park. Huge waves. Room for 5 more surfers, and every session there costs 5x.
    cost: 80000
    level: 20
    requires: pool_reef
  - id: faster_machine
    category: 0
    title: Turbo Pump
    description: The wave machine recharges twice as fast (4 s -> 2 s).
    cost: 75
    level: 1
    requires: 
  - id: auto_waves
    category: 0
    title: Auto Wave Timer
    description: The machine sends the selected wave by itself every 12 seconds. A yellow light turns on.
    cost: 200
    level: 2
    requires: 
  - id: intermediate_waves
    category: 0
    title: Intermediate Wave Program
    description: Unlocks bigger peeling Intermediate waves. Intermediate surfers start coming, and they pay 2.5x the base price.
    cost: 600
    level: 3
    requires: pool_expand_1
  - id: wave_sets
    category: 0
    title: Wave Sets
    description: Each press sends a set of 2 waves, 2.5 s apart. More rides, less waiting.
    cost: 900
    level: 5
    requires: faster_machine
  - id: smart_auto
    category: 0
    title: Smart Wave Timer
    description: Auto waves pick the wave type most waiting surfers want.
    cost: 2000
    level: 8
    requires: auto_waves
  - id: wave_shaper
    category: 0
    title: Reef Shaper
    description: Unlocks Lefts and Rights. They peel longer than a peak (longer rides, more tricks), and surfers pay $5 more for them. Regular-foot surfers love rights, goofy-foot surfers love lefts.
    cost: 2500
    level: 8
    requires: intermediate_waves
  - id: pro_waves
    category: 0
    title: Pro Wave Program
    description: 'Unlocks steep, fast, barreling Pro waves. Pro surfers start coming: they pay 6x the base price and do tricks.'
    cost: 4500
    level: 11
    requires: pool_expand_2
  - id: heavy_duty_pumps
    category: 0
    title: Heavy-Duty Pumps
    description: 'Tougher pumps in every wave machine: they wear out half as fast, so they break down much less.'
    cost: 3500
    level: 9
    requires: 
  - id: famous_waves
    category: 0
    title: Famous Waves Pack
    description: 'Wave programs copied from real spots: Waikiki, Malibu, Snapper Rocks, Pipeline (and Teahupo''o in the Big Wave Lagoon). Surfers love them: happier rides and 50% bigger tips.'
    cost: 6000
    level: 12
    requires: pro_waves
  - id: turbo_2
    category: 0
    title: Turbo Pump II
    description: Recharge time drops to 1 s. Auto waves every 8 s.
    cost: 4000
    level: 12
    requires: faster_machine
  - id: more_surfers
    category: 2
    title: Bigger Lineup
    description: Two more surfers can be in the park at once. Adds a bench by the pool.
    cost: 50
    level: 1
    requires: 
  - id: billboard
    category: 2
    title: Roadside Billboard
    description: Surfers arrive 30% more often.
    cost: 150
    level: 2
    requires: 
  - id: huge_lineup
    category: 2
    title: Huge Lineup
    description: Three more surfers can be in the park at once.
    cost: 1200
    level: 6
    requires: more_surfers
  - id: social_ads
    category: 2
    title: Social Media Ads
    description: Surfers arrive 40% more often.
    cost: 1500
    level: 7
    requires: billboard
  - id: tiki_garden
    category: 2
    title: Tiki Garden
    description: 'Palms, tiki torches and flower beds all around the pools. A prettier park: surfers will pay $10 more.'
    cost: 2000
    level: 8
    requires: 
  - id: beach_passes
    category: 2
    title: Beach Passes
    description: 'Open the beach to guests who don''t surf: they pay for a pass to relax on your loungers and benches (prettier park = pricier passes). Place seats with build mode (B)!'
    cost: 500
    level: 3
    requires: 
  - id: fishing_pier
    category: 2
    title: Fishing Pier
    description: 'A wooden pier out into the ocean on the west beach. Go fishing yourself: hook, reel, sell the catch (more if the snack bar can cook it).'
    cost: 700
    level: 4
    requires: 
  - id: pro_rod
    category: 2
    title: Pro Fishing Rod
    description: 'A stronger line (tension builds 30% slower) and better bait: big fish bite twice as often.'
    cost: 2000
    level: 8
    requires: fishing_pier
  - id: trash_cans
    category: 2
    title: Trash Cans
    description: Bins all around the decks. Surfers drop 60% less litter (trash on the ground makes them less happy).
    cost: 300
    level: 3
    requires: 
  - id: solar_panels
    category: 2
    title: Solar Panels
    description: Solar panels on every wave machine roof. Waves use half the electricity.
    cost: 1500
    level: 4
    requires: 
  - id: water_recycling
    category: 2
    title: Water Recycling
    description: Filter tanks next to every wave machine clean and reuse the pool water. The daily water bill is halved.
    cost: 5000
    level: 12
    requires: solar_panels
  - id: snack_bar
    category: 2
    title: Snack Bar
    description: A taco and smoothie kiosk by the exit. Happy surfers from the main pool stop for food ($10). Serve them at the grill (E)... and watch out for the wrappers.
    cost: 1200
    level: 5
    requires: 
  - id: smoothie_bar
    category: 2
    title: Bigger Snack Menu
    description: Burritos and loaded fries join the fish tacos and smoothies. Every snack sells for $8 more (and acai shakes a little more too).
    cost: 2500
    level: 8
    requires: snack_bar
  - id: photo_tower
    category: 2
    title: Surf Photographer
    description: 'A photo tower on the main pool''s north deck. Aim the long lens, zoom, and catch surfers at their best moment: shots are graded C to S. Surfers buy prints of good ones, and S shots go on the Wall of Fame.'
    cost: 4000
    level: 9
    requires: 
  - id: acai_bar
    category: 2
    title: Acai & Shake Shack
    description: 'A purple fruit shack by the west deck. Customers order acai bowls and shakes: grab a bowl or cup, add their toppings, blend, serve. Fast service = tips!'
    cost: 1500
    level: 6
    requires: 
  - id: surf_shop
    category: 2
    title: Surf Gear Shop
    description: 'A surf shack by the entrance full of boardshorts, rash guards, wax, fins and leashes. Grab what customers ask for and ring it up (bring extras: they might buy those too). Happy surfers also buy $15 of wax and stickers on the way out.'
    cost: 3500
    level: 10
    requires: 
  - id: board_shaper
    category: 2
    title: Custom Board Shaper
    description: 'A shaping shed on the east deck. Surfers order their dream board ($750-$950): plane a foam blank, spray their color, fit their fins. Big money per board.'
    cost: 12000
    level: 13
    requires: surf_shop
  - id: vip_sessions
    category: 2
    title: VIP Sessions
    description: Fancy towels, smoothies, priority lineup. Surfers will pay $25 more (times their skill and pool).
    cost: 8000
    level: 14
    requires: intermediate_waves
  - id: grandstand
    category: 2
    title: Grandstand
    description: Big bleachers by the main pool. Spectators pay $400 every minute to watch, and the buzz brings surfers 30% more often.
    cost: 22000
    level: 17
    requires: pro_waves
  - id: season_passes
    category: 2
    title: Season Passes
    description: 'Locals buy yearly passes: $1,000 every minute, even while you sleep.'
    cost: 35000
    level: 18
    requires: surf_shop
  - id: rental_stand
    category: 3
    title: Board Rental Stand
    description: Opens a rental counter. Surfers without boards start coming. Hand them a board from the rack ($10), then carry returned boards from the bin back to the rack.
    cost: 100
    level: 1
    requires: 
  - id: more_boards
    category: 3
    title: More Rental Boards
    description: Four more boards and slots on the rental rack.
    cost: 300
    level: 2
    requires: rental_stand
  - id: premium_boards
    category: 3
    title: Premium Boards
    description: 'Nicer boards: rentals cost $10 more.'
    cost: 400
    level: 4
    requires: rental_stand
  - id: lifeguard
    category: 4
    title: Hire Lifeguard
    description: Wage $3/min. Surfers wait 50% longer for waves and wipeouts don't ruin their mood.
    cost: 250
    level: 2
    requires: 
  - id: desk_clerk
    category: 4
    title: Hire Desk Clerk
    description: Wage $6/min. Sells sessions at the desk for you (at your prices).
    cost: 500
    level: 3
    requires: 
  - id: board_runner
    category: 4
    title: Hire Board Runner
    description: Wage $6/min. Carries returned boards from the bin back to the rack for you.
    cost: 600
    level: 4
    requires: rental_stand
  - id: rental_clerk
    category: 4
    title: Hire Rental Clerk
    description: Wage $8/min. Hands rental boards to renters for you.
    cost: 700
    level: 5
    requires: rental_stand
  - id: snack_cook
    category: 4
    title: Hire Snack Cook
    description: Wage $6/min. Cooks and serves every snack order at the snack bar for you.
    cost: 1500
    level: 6
    requires: snack_bar
  - id: acai_turbo_blender
    category: 2
    title: Turbo Blender
    description: 'A big chrome blender for the Acai & Shake Shack: shakes blend in less than half the time (and the barista works faster).'
    cost: 900
    level: 7
    requires: acai_bar
  - id: gear_card_reader
    category: 2
    title: Card Reader
    description: 'Tap-to-pay at the Surf Gear Shop: items ring up 2.5x faster, and the screen asks for a tip (+$3 on every sale).'
    cost: 2200
    level: 11
    requires: surf_shop
  - id: shaper_power_planer
    category: 2
    title: Power Planer
    description: 'A heavy-duty planer on a ceiling rail with a dust extractor: blanks shape in half the time (and the apprentice works faster).'
    cost: 5000
    level: 14
    requires: board_shaper
  - id: acai_barista
    category: 4
    title: Hire Acai Barista
    description: Wage $7/min. Makes and serves every bowl and shake at the Acai & Shake Shack (a little slower than you, smaller tips).
    cost: 1400
    level: 7
    requires: acai_bar
  - id: gear_clerk
    category: 4
    title: Hire Shop Clerk
    description: Wage $10/min. Fetches and rings up gear for every customer at the Surf Gear Shop.
    cost: 3000
    level: 11
    requires: surf_shop
  - id: shaper_apprentice
    category: 4
    title: Hire Apprentice Shaper
    description: 'Wage $30/min. Takes custom orders and shapes boards by themself (slowly: about 40 s a board).'
    cost: 9000
    level: 14
    requires: board_shaper
  - id: janitor
    category: 4
    title: Hire Janitor
    description: Wage $5/min. Walks the decks picking up every piece of trash, so the park stays spotless (and the inspector stays happy).
    cost: 900
    level: 5
    requires: 
  - id: mechanic
    category: 4
    title: Hire Mechanic
    description: Wage $10/min. Services worn wave machines and fixes broken ones in every pool, so you don't have to.
    cost: 1800
    level: 6
    requires: 
  - id: surf_coach
    category: 4
    title: Hire Surf Coach
    description: 'Wage $15/min. Gives beginners lessons: they wipe out far less, and each beginner session earns a $25 lesson fee.'
    cost: 2500
    level: 9
    requires: 
  - id: wave_operator
    category: 4
    title: Hire Wave Operator
    description: Wage $25/min. Watches every pool and sends exactly the wave the waiting surfers want. Full automation!
    cost: 6000
    level: 13
    requires: 
