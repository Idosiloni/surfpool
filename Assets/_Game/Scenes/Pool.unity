  m_GameObject: {fileID: 1112430376}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 49d4a24889feb488ea98d78ae8f7c571, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SurfPool.UpgradeShop
  upgrades:
  - id: faster_machine
    category: 0
    title: Turbo Pump
    description: The wave machine recharges twice as fast (4 s -> 2 s).
    cost: 100
    requires: 
  - id: auto_waves
    category: 0
    title: Auto Wave Timer
    description: The machine sends the selected wave by itself every 12 seconds. A yellow light turns on.
    cost: 150
    requires: 
  - id: wave_sets
    category: 0
    title: Wave Sets
    description: Each press sends a set of 2 waves, 2.5 s apart. More rides, less waiting.
    cost: 180
    requires: faster_machine
  - id: pro_waves
    category: 0
    title: Pro Wave Program
    description: Unlocks steep, fast Pro waves (select them on the wave console). Pro surfers pay the most and do tricks.
    cost: 200
    requires: 
  - id: smart_auto
    category: 0
    title: Smart Wave Timer
    description: Auto waves pick the wave type most waiting surfers want.
    cost: 220
    requires: auto_waves
  - id: turbo_2
    category: 0
    title: Turbo Pump II
    description: Recharge time drops to 1 s. Auto waves every 8 s.
    cost: 350
    requires: faster_machine
  - id: more_surfers
    category: 1
    title: Bigger Lineup
    description: Two more surfers can be in the park at once. Adds a bench by the pool.
    cost: 60
    requires: 
  - id: billboard
    category: 1
    title: Roadside Billboard
    description: Surfers arrive 30% more often.
    cost: 120
    requires: 
  - id: huge_lineup
    category: 1
    title: Huge Lineup
    description: Three more surfers can be in the park at once.
    cost: 250
    requires: more_surfers
  - id: social_ads
    category: 1
    title: Social Media Ads
    description: Surfers arrive 30% more often again.
    cost: 300
    requires: billboard
  - id: rental_stand
    category: 2
    title: Board Rental Stand
    description: Opens a rental counter. Surfers without boards start coming. Hand them a board from the rack ($10), then carry returned boards from the bin back to the rack.
    cost: 80
    requires: 
  - id: more_boards
    category: 2
    title: More Rental Boards
    description: Four more boards and slots on the rental rack.
    cost: 120
    requires: rental_stand
  - id: premium_boards
    category: 2
    title: Premium Boards
    description: 'Nicer boards: rentals cost $5 more.'
    cost: 200
    requires: rental_stand
  - id: lifeguard
    category: 3
    title: Hire Lifeguard
    description: Wage $3/min. Surfers wait 50% longer for waves and wipeouts don't ruin their mood.
    cost: 150
    requires: 
  - id: board_runner
    category: 3
    title: Hire Board Runner
    description: Wage $4/min. Carries returned boards from the bin back to the rack for you.
    cost: 200
    requires: rental_stand
  - id: rental_clerk
    category: 3
    title: Hire Rental Clerk
    description: Wage $5/min. Hands rental boards to renters for you.
    cost: 250
    requires: rental_stand
  - id: desk_clerk
    category: 3
    title: Hire Desk Clerk
    description: Wage $6/min. Sells tickets at the desk for you (at your price).
    cost: 300
    requires: 
  machine: {fileID: 1800440529}
  spawner: {fileID: 322000014}
  pricing: {fileID: 738170572}
